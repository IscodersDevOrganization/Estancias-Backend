@model Commons.Models.Page<DAL.Models.Sucursales>
@inject DAL.Data.EstanciasContext _context
@{
    var marcas = _context.Marcas.Where(x => x.Activo).OrderBy(x => x.Orden).ToList();
}

<div class="box box-info">
    <div class="box-header with-border filtro-grilla">
        <span class="txt-titulo-box">Listado de Sucursales</span>
        <div class="pull-right" style="display: flex; align-items: center;">
            <select id="marcaFiltroSucursales" class="form-control" style="width: 220px; display: inline-block;">
                <option value="">Todas las Marcas</option>
                @foreach (var m in marcas)
                {
                    <option value="@m.Nombre">@m.Nombre</option>
                }
            </select>
            <button type="button" class="btn btn-default btn-sm btn-clear-filters" style="margin-left: 8px; margin-right: 15px;" title="Limpiar filtros"><i class="fa fa-eraser"></i> <span class="hidden-xs">Limpiar</span></button>
            <a onclick="nuevaSucursal()" class="btn btn-info btn-sm">
                <i class="fa fa-plus"><span class="hidden-xs"> Nueva</span></i>
            </a>
        </div>
    </div>
    <div class="box-body">
        <table id="listadoSucursales" class="table table-hover table-bordered table-responsive borde_interno">
            <thead>
                <tr>
                    <th>
                        Nombre
                    </th>
                    <th>
                        Dirección
                    </th>
                    <th>
                        Telefono
                    </th>
                    <th>
                        Latitud
                    </th>
                    <th>
                        Longitud
                    </th>
                    <th>
                        Grupo
                    </th>
                    <th>
                        Marca
                    </th>
                    <th>
                        Acciones
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.name)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.address)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.phone)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.latitude)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.longitude)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.group)
                        </td>
                        <td>
                            @{
                                var marcasSucursal = _context.SucursalesMarcas
                                    .Where(sm => sm.Sucursales.Id == item.Id)
                                    .Select(sm => sm.Marca.Nombre)
                                    .ToList();
                            }
                            @if (marcasSucursal.Any())
                            {
                                @string.Join(", ", marcasSucursal)
                            }
                            else
                            {
                                <span class="text-muted">Sin Marca</span>
                            }
                        </td>
                        <td>
                            <a onclick="editSucursal('@item.Id')" title="Editar Sucursal" class="btn btn-primary btn-xs"><i class="fa fa-edit"></i></a>
                            <a asp-action="Delete" asp-route-id="@item.Id" confirm-icon="Danger" confirm-no="Cancelar" confirm-yes="Borrar" confirm="¿Esta seguro de borrar esta Sucursal?" class="btn btn-danger btn-xs"><i class="fa fa-trash-o"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<modal title="Nueva Sucursal" callback-modal="true" function="nuevaSucursal" load-url="/Core/Sucursales/_Create/" size="Medium"></modal>
<modal title="Edición de Sucursal" callback-modal="true" function="editSucursal" load-url="/Core/Sucursales/_Update/" size="Medium"></modal>

<script>
    var tableSucursales = null;
    var storageMarcaSucursalesKey = 'portal_flt_' + window.location.pathname.toLowerCase().replace(/\/$/, '') + '_marcafiltrosucursales';

    $(document).ready(function () {
        var savedMarca = sessionStorage.getItem(storageMarcaSucursalesKey);
        if (savedMarca !== null) {
            try { savedMarca = JSON.parse(savedMarca); } catch (e) {}
        }
        if (savedMarca) {
            $('#marcaFiltroSucursales').val(savedMarca);
        }

        tableSucursales = $('#listadoSucursales').DataTable({
            "columnDefs": [{ "targets": 0 }, { class: "text-center", "searchable": false, "orderable": false, "targets": 1 }],
            "language": {
                'url': '@Url.Content("~/lib/arg.json")'
            }
        });

        if (savedMarca) {
            tableSucursales.column(6).search($.fn.dataTable.util.escapeRegex(savedMarca), true, false).draw();
        }

        $('#marcaFiltroSucursales').on('change', function () {
            var val = $(this).val();
            if (val) {
                sessionStorage.setItem(storageMarcaSucursalesKey, JSON.stringify(val));
            } else {
                sessionStorage.removeItem(storageMarcaSucursalesKey);
            }
            tableSucursales.column(6).search(val ? $.fn.dataTable.util.escapeRegex(val) : '', true, false).draw();
        });
    });
</script>
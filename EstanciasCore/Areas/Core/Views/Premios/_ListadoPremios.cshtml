@model Commons.Models.Page<DAL.Models.Premios>
@inject DAL.Data.EstanciasContext _context
@{
    var marcas = _context.Marcas.Where(x => x.Activo).OrderBy(x => x.Orden).ToList();
}

<div class="box box-info">
    <div class="box-header with-border filtro-grilla">
        <span class="txt-titulo-box">Listado de Cupones</span>
        <div class="pull-right" style="display: flex; align-items: center;">
            <select id="marcaFiltroPremios" class="form-control" style="width: 220px; display: inline-block;">
                <option value="">Todas las Marcas</option>
                @foreach (var m in marcas)
                {
                    <option value="@m.Nombre">@m.Nombre</option>
                }
            </select>
            <button type="button" class="btn btn-default btn-sm btn-clear-filters" style="margin-left: 8px; margin-right: 15px;" title="Limpiar filtros"><i class="fa fa-eraser"></i> <span class="hidden-xs">Limpiar</span></button>
            <a onclick="nuevoPremio()" class="btn btn-info btn-sm">
                <i class="fa fa-plus"><span class="hidden-xs"> Nueva</span></i>
            </a>
        </div>
    </div>
    <div class="box-body">
        <table id="listadoPremios" class="table table-hover table-bordered table-responsive borde_interno">
            <thead>
                <tr>
                    <th>
                        Nombre
                    </th>
                    <th>
                        Descripción
                    </th>
                    <th>
                        Stock
                    </th>
                    <th>
                        Stock Actual
                    </th>
                    <th>
                        Puntos
                    </th>
                    <th>
                        Categoría
                    </th>
                    <th>
                        Marca
                    </th>
                    <th>
                        Días de Venc.
                    </th>
                    <th>
                        Fecha Vencimiento
                    </th>
                    <th>
                        Activo
                    </th>
                    <th>
                        Acciones
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.Nombre)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Descripcion)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Stock)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.StockActual)
                        </td>
                        <td>
                            @item.Puntos
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Categoria.Nombre)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Marcas.Nombre)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.DiasDeVencimiento)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.FechaVencimiento)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Activo)
                        </td>
                        <td>
                            <a onclick="editPremio('@item.Id')" title="Editar País" class="btn btn-primary btn-xs"><i class="fa fa-edit"></i></a>

                            <a onclick="imagen(@item.Id)" title="Cambiar Foto" class="btn btn-primary btn-xs"><i class="fa fa-image"></i></a>

                            <a asp-action="Delete" asp-route-id="@item.Id" confirm-icon="Danger" confirm-no="Cancelar" confirm-yes="Borrar" confirm="¿Esta seguro de borrar este Premio?" class="btn btn-danger btn-xs"><i class="fa fa-trash-o"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<modal title="Nuevo Premio" callback-modal="true" function="nuevoPremio" load-url="/Core/Premios/_Create/" size="Medium"></modal>
<modal title="Edición de Premio" callback-modal="true" function="editPremio" load-url="/Core/Premios/_Update/" size="Medium"></modal>
<modal title="Cambiar Foto" function="imagen" load-url="/Core/Premios/_CambiarImagen/" size="Medium"></modal>

<script>
    var tablePremios = null;
    var storageMarcaPremiosKey = 'portal_flt_' + window.location.pathname.toLowerCase().replace(/\/$/, '') + '_marcafiltropremios';

    $(document).ready(function () {
        var savedMarca = sessionStorage.getItem(storageMarcaPremiosKey);
        if (savedMarca !== null) {
            try { savedMarca = JSON.parse(savedMarca); } catch (e) {}
        }
        if (savedMarca) {
            $('#marcaFiltroPremios').val(savedMarca);
        }

        tablePremios = $('#listadoPremios').DataTable({
            "columnDefs": [{ "width": "10%", class: "text-center", "searchable": false, "orderable": false, "targets": -1 }],
            "language": {
                'url': '@Url.Content("~/lib/arg.json")'
            }
        });

        if (savedMarca) {
            tablePremios.column(6).search('^' + $.fn.dataTable.util.escapeRegex(savedMarca) + ', true, false).draw();
        }

        $('#marcaFiltroPremios').on('change', function () {
            var val = $(this).val();
            if (val) {
                sessionStorage.setItem(storageMarcaPremiosKey, JSON.stringify(val));
            } else {
                sessionStorage.removeItem(storageMarcaPremiosKey);
            }
            tablePremios.column(6).search(val ? '^' + $.fn.dataTable.util.escapeRegex(val) + ' : '', true, false).draw();
        });
    });
</script>
@{
    Layout = null;
    var periodos = (List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Periodos;
}

<style>
    @@media (min-width: 768px) {
        .modal-dialog { width: 92% !important; max-width: 1200px !important; }
    }
    .sim-aviso { display: flex; gap: 10px; align-items: flex-start; background: #fffbeb; border: 1px solid #fde68a; color: #92400e; border-radius: 10px; padding: 10px 14px; font-size: 12.5px; margin-bottom: 16px; }
    .sim-aviso i { margin-top: 2px; }
    .sim-form { display: grid; grid-template-columns: 1fr 1.5fr 0.9fr auto; gap: 14px; align-items: start; }
    .sim-form .sim-boton { padding-top: 22px; }
    .sim-form label { font-size: 12px; font-weight: 600; color: #475569; margin-bottom: 4px; display: block; height: 18px; line-height: 18px; }
    .sim-form .form-control { height: 38px; border-radius: 8px; border: 1px solid #e2e8f0; box-shadow: none; width: 100%; }
    .sim-form select.form-control { padding-right: 28px; text-overflow: ellipsis; }
    .sim-form .btn { height: 38px; border-radius: 8px; padding: 0 18px; white-space: nowrap; }
    .sim-ayuda { font-size: 11px; color: #94a3b8; margin-top: 3px; }
    .sim-resultado { margin-top: 18px; }
    .sim-datos { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-bottom: 12px; }
    .sim-dato { background: #f8fafc; border: 1px solid #f1f5f9; border-radius: 10px; padding: 8px 12px; }
    .sim-dato-label { font-size: 10.5px; font-weight: 700; letter-spacing: .5px; text-transform: uppercase; color: #94a3b8; }
    .sim-dato-valor { font-size: 13.5px; color: #0f172a; font-weight: 600; word-break: break-word; }
    .sim-dato.total { background: #eff6ff; border-color: #dbeafe; }
    .sim-dato.total .sim-dato-valor { color: #1d4ed8; font-size: 16px; }
    .sim-barra { display: flex; justify-content: space-between; align-items: center; gap: 10px; margin-bottom: 10px; flex-wrap: wrap; }
    .sim-visor { width: 100%; height: 70vh; border: 1px solid #e2e8f0; border-radius: 10px; background: #f1f5f9; }
    .sim-error { background: #fef2f2; border: 1px solid #fecaca; color: #991b1b; border-radius: 10px; padding: 12px 14px; }
    .sim-error pre { white-space: pre-wrap; word-break: break-word; font-size: 11px; max-height: 220px; overflow: auto; background: transparent; border: none; color: #991b1b; margin: 8px 0 0; padding: 0; }
    @@media (max-width: 900px) {
        .sim-form { grid-template-columns: 1fr; }
        .sim-datos { grid-template-columns: repeat(2, 1fr); }
    }
</style>

<div style="padding: 4px 6px;">
    <div class="sim-aviso">
        <i class="fa fa-info-circle"></i>
        <div>
            Genera el resumen con <strong>la misma lógica que la generación mensual</strong> (datos del WS en este momento, cuotas y punitorios),
            pero <strong>no guarda nada</strong> y <strong>no envía ningún mail</strong>. El PDF sale con la marca de agua <strong>SIMULACIÓN</strong>.
        </div>
    </div>

    <form id="formSimular" class="sim-form" autocomplete="off" data-ajax="true">
        <div>
            <label for="simDocumento">DNI o Nro. de tarjeta</label>
            <input type="text" id="simDocumento" name="documentoOTarjeta" class="form-control" placeholder="Ej: 30123456" />
        </div>
        <div>
            <label for="simPeriodo">Período</label>
            <select id="simPeriodo" name="periodo" class="form-control">
                @foreach (var p in periodos)
                {
                    <option value="@p.Value" selected="@p.Selected">@p.Text</option>
                }
            </select>
        </div>
        <div>
            <label for="simFecha">Fecha de generación</label>
            <input type="date" id="simFecha" name="fechaGeneracion" class="form-control" />
            <div class="sim-ayuda">Vacío = día 1 del mes de vencimiento</div>
        </div>
        <div class="sim-boton">
            <button type="submit" id="btnSimular" class="btn btn-primary"><i class="fa fa-cogs"></i> Simular</button>
        </div>
    </form>

    <div id="simResultado" class="sim-resultado"></div>
</div>

<script>
    (function () {
        var urlPdfActual = null;

        function esc(t) {
            if (t === null || t === undefined) return '';
            return String(t).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        }

        function dato(label, valor, clase) {
            return '<div class="sim-dato ' + (clase || '') + '"><div class="sim-dato-label">' + label + '</div><div class="sim-dato-valor">' + esc(valor) + '</div></div>';
        }

        function base64ABlob(b64) {
            var bin = atob(b64), len = bin.length, bytes = new Uint8Array(len);
            for (var i = 0; i < len; i++) bytes[i] = bin.charCodeAt(i);
            return new Blob([bytes], { type: 'application/pdf' });
        }

        $('#formSimular').on('submit', function (e) {
            e.preventDefault();
            if (!$.trim($('#simDocumento').val())) { $('#simDocumento').focus(); return; }

            if (urlPdfActual) { URL.revokeObjectURL(urlPdfActual); urlPdfActual = null; }
            $('#btnSimular').prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Generando...');
            $('#simResultado').html('<div class="text-center" style="padding: 40px 0; color: #94a3b8;"><i class="fa fa-spinner fa-spin fa-2x"></i><p style="margin-top: 8px;">Consultando el WS y armando el resumen...</p></div>');

            $.post('@Url.Action("SimularResumen", "ResumenTarjetaReportes")', $(this).serialize())
                .done(function (r) {
                    if (!r.ok) {
                        $('#simResultado').html(
                            '<div class="sim-error"><strong><i class="fa fa-exclamation-triangle"></i> No se pudo generar el resumen.</strong>' +
                            (r.codigo ? ' <code>' + esc(r.codigo) + '</code>' : '') +
                            '<div style="margin-top: 6px;">' + esc(r.mensaje) + '</div>' +
                            (r.detalle ? '<pre>' + esc(r.detalle) + '</pre>' : '') + '</div>');
                        return;
                    }

                    urlPdfActual = URL.createObjectURL(base64ABlob(r.pdf));

                    var html =
                        (r.variosClientes ? '<div class="sim-aviso"><i class="fa fa-users"></i><div>Hay más de un cliente con ese dato: se usó el primero. Probá con el número de tarjeta para ser más preciso.</div></div>' : '') +
                        '<div class="sim-datos">' +
                            dato('Cliente', r.nombre) +
                            dato('DNI / Tarjeta', r.documento + ' / ' + r.tarjeta) +
                            dato('Mail', r.mail) +
                            dato('Período', r.periodo + ' (' + r.periodoDesde + ' al ' + r.periodoHasta + ')') +
                            dato('Vencimiento', r.vencimiento) +
                            dato('Generado como si fuera', r.fechaGeneracion) +
                            dato('Saldo pendiente (' + r.consumosAnteriores + ' cuotas)', r.saldoPendiente) +
                            dato('Saldo del mes (' + r.consumosDelMes + ' cuotas)', r.saldoActual) +
                            dato('Total a pagar', r.saldoTotal, 'total') +
                        '</div>' +
                        '<div class="sim-barra">' +
                            '<span class="text-muted" style="font-size: 12px;"><i class="fa fa-flask"></i> Vista previa · no se guardó nada</span>' +
                            '<div>' +
                                '<a href="' + urlPdfActual + '" target="_blank" data-ajax="true" class="btn btn-default btn-sm" style="border-radius: 8px;"><i class="fa fa-external-link"></i> Abrir en pestaña</a> ' +
                                '<a href="' + urlPdfActual + '" data-ajax="true" download="' + esc(r.nombreArchivo) + '" class="btn btn-success btn-sm" style="border-radius: 8px;"><i class="fa fa-download"></i> Descargar PDF</a>' +
                            '</div>' +
                        '</div>' +
                        '<iframe class="sim-visor" src="' + urlPdfActual + '"></iframe>';

                    $('#simResultado').html(html);
                })
                .fail(function (xhr) {
                    $('#simResultado').html('<div class="sim-error"><strong>Error ' + xhr.status + '</strong> ' + esc(xhr.statusText) + '</div>');
                })
                .always(function () {
                    $('#btnSimular').prop('disabled', false).html('<i class="fa fa-cogs"></i> Simular');
                });
        });

        setTimeout(function () { $('#simDocumento').focus(); }, 300);
    })();
</script>

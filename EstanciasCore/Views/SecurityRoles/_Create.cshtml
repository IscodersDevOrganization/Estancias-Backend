@using Commons.Identity
@using Microsoft.AspNetCore.Mvc.Infrastructure
@inject DAL.Data.EstanciasContext _context
@inject IActionDescriptorCollectionProvider _actionDescriptorProvider
@model Commons.Identity.CommonsRole
@{
    ViewData["Title"] = "Crear Rol y Funciones";
    var functions = ViewBag.Functions as List<CommonsFunction> 
                    ?? _context.Set<CommonsFunction>().Where(f => f.DeletedDate == null).OrderBy(f => f.Name).ToList();

    var rawRouteGroups = ViewBag.RouteGroups as List<EstanciasCore.Controllers.SecurityRolesController.RouteGroup>;
    var routeGroups = new List<dynamic>();

    if (rawRouteGroups != null && rawRouteGroups.Any())
    {
        foreach (var g in rawRouteGroups)
        {
            routeGroups.Add(new {
                ControllerName = string.IsNullOrEmpty(g?.ControllerName) ? "Otros" : g.ControllerName,
                AreaName = g?.AreaName ?? "",
                Routes = g?.Routes ?? new List<string>()
            });
        }
    }
    else if (_actionDescriptorProvider != null)
    {
        var groupsDict = new Dictionary<string, dynamic>();
        foreach (var ad in _actionDescriptorProvider.ActionDescriptors.Items)
        {
            var controller = ad.RouteValues["controller"];
            var action = ad.RouteValues["action"];
            var area = ad.RouteValues.ContainsKey("area") ? ad.RouteValues["area"] : null;

            var path = "";
            if (ad.AttributeRouteInfo != null && !string.IsNullOrEmpty(ad.AttributeRouteInfo.Template))
            {
                path = ad.AttributeRouteInfo.Template;
                if (!path.StartsWith("/")) { path = "/" + path; }
            }
            else
            {
                path = (!string.IsNullOrEmpty(area) ? $"/{area}" : "") + $"/{controller}/{action}";
            }

            var key = $"{area}_{controller}";
            if (!groupsDict.ContainsKey(key))
            {
                groupsDict[key] = new {
                    ControllerName = controller,
                    AreaName = area ?? "",
                    Routes = new List<string>()
                };
            }
            ((List<string>)groupsDict[key].Routes).Add(path);
        }

        foreach (var g in groupsDict.Values)
        {
            var rList = ((List<string>)g.Routes).Distinct().OrderBy(r => r).ToList();
            routeGroups.Add(new {
                ControllerName = (string)g.ControllerName,
                AreaName = (string)g.AreaName,
                Routes = rList
            });
        }
    }

    routeGroups = routeGroups
        .OrderBy(g => (string)g.AreaName)
        .ThenBy(g => (string)g.ControllerName)
        .ToList();
}

<style>

<div class="role-modal-container" id="roleModalRoot">
    <form asp-action="_Assign" asp-controller="SecurityRoles" method="post" id="formAssignRoles">
        <input type="hidden" name="userId" value="@user?.Id" />

        <!-- Header -->
        <div class="role-modal-header">
            <div class="role-modal-header-left">
                <div class="role-shield-badge">
                    <i class="fa fa-shield"></i>
                </div>
                <div class="role-header-titles">
                    <h3 class="role-header-title">Asignar Permisos y Roles Locales</h3>
                    <p class="role-header-subtitle">Usuario: <strong>@userNameDisplay</strong> — @userEmailDisplay</p>
                </div>
            </div>
            <button type="button" class="role-modal-close-btn" data-dismiss="modal" title="Cerrar">&times;</button>
        </div>

        <!-- Toolbar: Módulos y Filtro -->
        <div class="role-toolbar-row">
            <div class="role-toolbar-title">
                MÓDULOS Y PERMISOS DISPONIBLES (<span class="badge-count" id="lblRolesSeleccionadosCount">@assignedRoleIds.Count SELECCIONADOS</span>):
            </div>
            <div class="role-search-wrap">
                <i class="fa fa-search"></i>
                <input type="text" id="roleFilterInput" class="role-search-input" placeholder="Filtrar permisos..." oninput="filterRolesLive(this.value)">
            </div>
        </div>

        <!-- Contenedor de 2 Columnas Balanceadas (Izquierda: Datos + Reportes + Sistema | Derecha: Gestión) -->
        <div class="role-modules-columns">
            <!-- Columna Izquierda: Datos, Reportes y Sistema -->
            <div class="role-modules-col-left">
                @foreach (var mod in leftModules)
                {
                    <div class="role-module-card card-module-@mod.Key" id="card-module-@mod.Key">
                        <div class="role-module-card-header">
                            <div class="role-module-titles">
                                <h5 class="role-module-name">@mod.Title</h5>
                                <p class="role-module-desc">@mod.Description</p>
                            </div>
                            @if (mod.RoleItems.Any())
                            {
                                <button type="button" class="btn-card-toggle-all" data-module="@mod.Key" onclick="toggleSelectAllInModule('@mod.Key')">
                                    Marcar todo
                                </button>
                            }
                        </div>
                        <div class="role-items-list" id="list-module-@mod.Key">
                            @if (!mod.RoleItems.Any())
                            {
                                <div class="role-empty-module">
                                    <i class="fa fa-info-circle"></i> Sin roles configurados en este módulo.
                                </div>
                            }
                            else
                            {
                                var groupedSubcats = mod.RoleItems
                                    .GroupBy(x => string.IsNullOrWhiteSpace(x.Subcategory) ? "" : x.Subcategory)
                                    .OrderBy(g => string.IsNullOrEmpty(g.Key) ? "zzz" : (g.Key == "Cupones" ? "aaa" : g.Key))
                                    .ToList();

                                foreach (var grp in groupedSubcats)
                                {
                                    var hasGroupTitle = !string.IsNullOrWhiteSpace(grp.Key);
                                    <div class="role-subcat-section @(hasGroupTitle ? "is-grouped" : "is-ungrouped")" data-subcat="@(hasGroupTitle ? grp.Key.ToLower() : "")">
                                        @if (hasGroupTitle)
                                        {
                                            <div class="role-group-header">
                                                <div class="role-group-title">
                                                    <i class="fa fa-folder-open"></i> @grp.Key
                                                </div>
                                                <div class="role-group-header-right">
                                                    <button type="button" class="btn-subgroup-toggle" onclick="toggleSelectSubgroup(this, event)">Marcar</button>
                                                    <span class="role-group-count-badge">@grp.Count() @(grp.Count() == 1 ? "permiso" : "permisos")</span>
                                                </div>
                                            </div>
                                        }
                                        else if (groupedSubcats.Any(g => !string.IsNullOrEmpty(g.Key)))
                                        {
                                            <div class="role-ungrouped-divider">
                                                <span class="role-ungrouped-divider-label">
                                                    <i class="fa fa-th-list"></i> Otros Permisos Generales
                                                </span>
                                                <span class="role-ungrouped-divider-count">@grp.Count()</span>
                                            </div>
                                        }
                                        <div class="role-group-items">
                                            @foreach (var item in grp)
                                            {
                                                var role = item.Role;
                                                var isChecked = assignedRoleIds.Contains(role.Id);
                                                <div class="role-item-row @(isChecked ? "is-selected" : "")" data-role-text="@((role.ShowName ?? "") + " " + grp.Key + " " + (item.CleanDescription ?? "")).ToLower()" onclick="handleRoleItemRowClick(this, event)">
                                                    <div class="role-item-check-wrap">
                                                        <!input type="checkbox" name="selectedRoleIds" value="@role.Id" @(isChecked ? "checked=\"checked\"" : "") class="role-checkbox-custom" onclick="event.stopPropagation(); onRoleCheckboxToggled(this);" />
                                                    </div>
                                                    <div class="role-item-shield-icon">
                                                        <i class="fa fa-shield"></i>
                                                    </div>
                                                    <div class="role-item-details">
                                                        <span class="role-item-label">@role.ShowName</span>
                                                        @if (!string.IsNullOrEmpty(item.CleanDescription))
                                                        {
                                                            <span class="role-item-subtext">@item.CleanDescription</span>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- Columna Derecha: Gestión -->
            <div class="role-modules-col-right">
                @foreach (var mod in rightModules)
                {
                    <div class="role-module-card card-module-@mod.Key" id="card-module-@mod.Key">
                        <div class="role-module-card-header">
                            <div class="role-module-titles">
                                <h5 class="role-module-name">@mod.Title</h5>
                                <p class="role-module-desc">@mod.Description</p>
                            </div>
                            @if (mod.RoleItems.Any())
                            {
                                <button type="button" class="btn-card-toggle-all" data-module="@mod.Key" onclick="toggleSelectAllInModule('@mod.Key')">
                                    Marcar todo
                                </button>
                            }
                        </div>
                        <div class="role-items-list" id="list-module-@mod.Key">
                            @if (!mod.RoleItems.Any())
                            {
                                <div class="role-empty-module">
                                    <i class="fa fa-info-circle"></i> Sin roles configurados en este módulo.
                                </div>
                            }
                            else
                            {
                                var groupedSubcats = mod.RoleItems
                                    .GroupBy(x => string.IsNullOrWhiteSpace(x.Subcategory) ? "" : x.Subcategory)
                                    .OrderBy(g => string.IsNullOrEmpty(g.Key) ? "zzz" : (g.Key == "Cupones" ? "aaa" : g.Key))
                                    .ToList();

                                foreach (var grp in groupedSubcats)
                                {
                                    var hasGroupTitle = !string.IsNullOrWhiteSpace(grp.Key);
                                    <div class="role-subcat-section @(hasGroupTitle ? "is-grouped" : "is-ungrouped")" data-subcat="@(hasGroupTitle ? grp.Key.ToLower() : "")">
                                        @if (hasGroupTitle)
                                        {
                                            <div class="role-group-header">
                                                <div class="role-group-title">
                                                    <i class="fa fa-folder-open"></i> @grp.Key
                                                </div>
                                                <div class="role-group-header-right">
                                                    <button type="button" class="btn-subgroup-toggle" onclick="toggleSelectSubgroup(this, event)">Marcar</button>
                                                    <span class="role-group-count-badge">@grp.Count() @(grp.Count() == 1 ? "permiso" : "permisos")</span>
                                                </div>
                                            </div>
                                        }
                                        else if (groupedSubcats.Any(g => !string.IsNullOrEmpty(g.Key)))
                                        {
                                            <div class="role-ungrouped-divider">
                                                <span class="role-ungrouped-divider-label">
                                                    <i class="fa fa-th-list"></i> Otros Permisos Generales
                                                </span>
                                                <span class="role-ungrouped-divider-count">@grp.Count()</span>
                                            </div>
                                        }
                                        <div class="role-group-items">
                                            @foreach (var item in grp)
                                            {
                                                var role = item.Role;
                                                var isChecked = assignedRoleIds.Contains(role.Id);
                                                <div class="role-item-row @(isChecked ? "is-selected" : "")" data-role-text="@((role.ShowName ?? "") + " " + grp.Key + " " + (item.CleanDescription ?? "")).ToLower()" onclick="handleRoleItemRowClick(this, event)">
                                                    <div class="role-item-check-wrap">
                                                        <!input type="checkbox" name="selectedRoleIds" value="@role.Id" @(isChecked ? "checked=\"checked\"" : "") class="role-checkbox-custom" onclick="event.stopPropagation(); onRoleCheckboxToggled(this);" />
                                                    </div>
                                                    <div class="role-item-shield-icon">
                                                        <i class="fa fa-shield"></i>
                                                    </div>
                                                    <div class="role-item-details">
                                                        <span class="role-item-label">@role.ShowName</span>
                                                        @if (!string.IsNullOrEmpty(item.CleanDescription))
                                                        {
                                                            <span class="role-item-subtext">@item.CleanDescription</span>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Footer -->
        <div class="role-modal-footer">
            <div class="role-footer-count">
                <strong id="lblRolesFooterCount">@assignedRoleIds.Count</strong> rol(es) marcado(s) actualmente
            </div>
            <div class="role-footer-actions">
                <button type="button" class="btn btn-default btn-sm" data-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary btn-sm">Guardar Cambios</button>
            </div>
        </div>
    </form>
</div>

<script>
    $(function () {
        // Asegurar que todos los items con clase is-selected tengan su checkbox marcado
        $('#roleModalRoot .role-item-row.is-selected input.role-checkbox-custom').prop('checked', true);
        
        // Sincronizar clases is-selected si el checkbox vino checked del HTML
        $('#roleModalRoot input.role-checkbox-custom:checked').closest('.role-item-row').addClass('is-selected');

        // Ocultar modal-header y modal-footer genéricos del contenedor padre si existen
        var $modal = $('#roleModalRoot').closest('.modal');
        if ($modal.length > 0) {
            $modal.find('.modal-header').hide();
            $modal.find('.modal-footer').hide();
            $modal.find('.modal-dialog').addClass('modal-lg').css({
                'max-width': '980px',
                'width': '94%',
                'margin': '25px auto'
            });
            $modal.find('.modal-body').css({
                'padding': '22px 26px',
                'background': '#ffffff',
                'border-radius': '14px',
                'max-height': '88vh',
                'overflow-y': 'auto'
            });
            $modal.find('.modal-content').css({
                'border-radius': '14px',
                'border': '1px solid #e2e8f0',
                'box-shadow': '0 25px 50px -12px rgba(0, 0, 0, 0.25)',
                'overflow': 'hidden'
            });
        }

        updateAllSubgroupButtonStates();
        updateAllCardButtonStates();
        updateSelectedCounter();

        // Envío AJAX del formulario de asignación de roles sin recargar la página completa
        $('#formAssignRoles').off('submit').on('submit', function (e) {
            e.preventDefault();
            e.stopPropagation();
            if (e.stopImmediatePropagation) {
                e.stopImmediatePropagation();
            }

            var $form = $(this);
            if ($form.data('submitting')) {
                return false;
            }
            $form.data('submitting', true);

            var $btnSubmit = $form.find('button[type="submit"]');
            var originalBtnHtml = $btnSubmit.html();
            $btnSubmit.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Guardando...');

            $.ajax({
                url: $form.attr('action') || '/SecurityRoles/_Assign',
                type: 'POST',
                data: $form.serialize(),
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                },
                success: function (res) {
                    $form.data('submitting', false);
                    $btnSubmit.prop('disabled', false).html(originalBtnHtml);
                    if (res && res.success) {
                        var $modal = $form.closest('.modal');
                        if ($modal.length) {
                            $modal.modal('hide');
                        } else {
                            $('.modal').modal('hide');
                        }

                        if (typeof userRolesMap !== 'undefined' && res.userId) {
                            userRolesMap[res.userId] = res.roleNames || [];
                        }

                        if (typeof Swal !== 'undefined') {
                            Swal.fire({
                                toast: true,
                                position: 'top-end',
                                icon: 'success',
                                title: res.message || 'Roles actualizados correctamente',
                                showConfirmButton: false,
                                timer: 3000
                            });
                        }

                        if (typeof $ !== 'undefined' && $.fn && $.fn.dataTable) {
                            var dt = $('#usersTable').DataTable();
                            if (dt) {
                                dt.ajax.reload(null, false);
                            }
                        }
                    } else {
                        var msg = (res && res.message) ? res.message : 'Error al guardar los roles';
                        if (typeof Swal !== 'undefined') {
                            Swal.fire('Error', msg, 'error');
                        } else {
                            alert(msg);
                        }
                    }
                },
                error: function (xhr) {
                    $form.data('submitting', false);
                    $btnSubmit.prop('disabled', false).html(originalBtnHtml);
                    var errMsg = 'Error de conexión al procesar la solicitud.';
                    if (xhr && xhr.responseJSON && xhr.responseJSON.message) {
                        errMsg = xhr.responseJSON.message;
                    }
                    if (typeof Swal !== 'undefined') {
                        Swal.fire('Error', errMsg, 'error');
                    } else {
                        alert(errMsg);
                    }
                }
            });
        });
    });

    // Click en la fila completa del rol
    function handleRoleItemRowClick(rowElem, evt) {
        if ($(evt.target).is('input[type="checkbox"]')) return;
        var $chk = $(rowElem).find('input.role-checkbox-custom');
        $chk.prop('checked', !$chk.prop('checked'));
        onRoleCheckboxToggled($chk[0]);
    }

    // Cambio en checkbox de rol
    function onRoleCheckboxToggled(chkElem) {
        var $chk = $(chkElem);
        var $row = $chk.closest('.role-item-row');
        if ($chk.is(':checked')) {
            $row.addClass('is-selected');
        } else {
            $row.removeClass('is-selected');
        }

        updateSubgroupButtonState($row.closest('.role-subcat-section'));
        var $card = $chk.closest('.role-module-card');
        updateCardButtonState($card);
        updateSelectedCounter();
    }

    // Marcar / Desmarcar todos los roles de un subgrupo específico
    function toggleSelectSubgroup(btn, event) {
        event.stopPropagation();
        var $sec = $(btn).closest('.role-subcat-section');
        var $checkboxes = $sec.find('.role-item-row:visible input.role-checkbox-custom');
        if ($checkboxes.length === 0) return;

        var checkedCount = $checkboxes.filter(':checked').length;
        var newCheckedState = (checkedCount !== $checkboxes.length);

        $checkboxes.prop('checked', newCheckedState);
        $sec.find('.role-item-row:visible').each(function () {
            $(this).toggleClass('is-selected', newCheckedState);
        });

        updateSubgroupButtonState($sec);
        updateCardButtonState($sec.closest('.role-module-card'));
        updateSelectedCounter();
    }

    function updateSubgroupButtonState($sec) {
        if (!$sec || !$sec.hasClass('is-grouped')) return;
        var $btn = $sec.find('.btn-subgroup-toggle');
        if ($btn.length === 0) return;
        var $checkboxes = $sec.find('.role-item-row:visible input.role-checkbox-custom');
        if ($checkboxes.length === 0) return;
        var checkedCount = $checkboxes.filter(':checked').length;
        if (checkedCount === $checkboxes.length) {
            $btn.text('Desmarcar');
        } else {
            $btn.text('Marcar');
        }
    }

    function updateAllSubgroupButtonStates() {
        $('.role-subcat-section.is-grouped').each(function () {
            updateSubgroupButtonState($(this));
        });
    }

    // Botón "Marcar todo / Desmarcar todo" de cada tarjeta
    function toggleSelectAllInModule(moduleKey) {
        var $card = $('#card-module-' + moduleKey);
        var $visibleRows = $card.find('.role-item-row:visible');
        if ($visibleRows.length === 0) return;

        var allChecked = true;
        $visibleRows.each(function () {
            if (!$(this).find('input.role-checkbox-custom').is(':checked')) {
                allChecked = false;
                return false;
            }
        });

        var newCheckedState = !allChecked;
        $visibleRows.each(function () {
            var $row = $(this);
            var $chk = $row.find('input.role-checkbox-custom');
            $chk.prop('checked', newCheckedState);
            if (newCheckedState) {
                $row.addClass('is-selected');
            } else {
                $row.removeClass('is-selected');
            }
        });

        $card.find('.role-subcat-section.is-grouped').each(function () {
            updateSubgroupButtonState($(this));
        });

        updateCardButtonState($card);
        updateSelectedCounter();
    }

    // Actualiza el texto del botón Marcar/Desmarcar de una tarjeta
    function updateCardButtonState($card) {
        var $btn = $card.find('.btn-card-toggle-all');
        if ($btn.length === 0) return;

        var $checkboxes = $card.find('.role-item-row:visible input.role-checkbox-custom');
        if ($checkboxes.length === 0) {
            $btn.text('Marcar todo');
            return;
        }

        var checkedCount = $checkboxes.filter(':checked').length;
        if (checkedCount === $checkboxes.length) {
            $btn.text('Desmarcar todo');
        } else {
            $btn.text('Marcar todo');
        }
    }

    function updateAllCardButtonStates() {
        $('.role-module-card').each(function () {
            updateCardButtonState($(this));
        });
    }

    // Actualiza los contadores en toolbar y footer
    function updateSelectedCounter() {
        var totalSelected = $('#roleModalRoot input.role-checkbox-custom:checked').length;
        $('#lblRolesSeleccionadosCount').text(totalSelected + ' SELECCIONADOS');
        $('#lblRolesFooterCount').text(totalSelected);
    }

    // Filtro de búsqueda en vivo
    function filterRolesLive(query) {
        var q = (query || '').trim().toLowerCase();

        $('.role-module-card').each(function () {
            var $card = $(this);
            var $sections = $card.find('.role-subcat-section');
            var cardMatches = 0;

            $sections.each(function () {
                var $sec = $(this);
                var $rows = $sec.find('.role-item-row');
                var matchedInGroup = 0;

                $rows.each(function () {
                    var $row = $(this);
                    var text = $row.data('role-text') || '';
                    if (!q || text.indexOf(q) !== -1) {
                        $row.show();
                        matchedInGroup++;
                    } else {
                        $row.hide();
                    }
                });

                if (!q || matchedInGroup > 0) {
                    $sec.show();
                    updateSubgroupButtonState($sec);
                    cardMatches += matchedInGroup;
                } else {
                    $sec.hide();
                }
            });

            if (!q || cardMatches > 0) {
                $card.show();
            } else {
                $card.hide();
            }

            updateCardButtonState($card);
        });
    }
</script>

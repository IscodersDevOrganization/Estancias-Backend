@using Commons.Identity
@using DAL.Models
@functions {
    public class RoleHierarchyItem
    {
        public CommonsRole Role { get; set; }
        public string Subcategory { get; set; }
        public string CleanDescription { get; set; }
    }

    public static (string Category, string Subcategory, string CleanDesc) ParseRoleCategoryAndSubcat(CommonsRole role)
    {
        var desc = role.Description ?? "";
        var name = role.ShowName ?? role.Name ?? "";
        var cat = "";
        var subcat = "";
        var cleanDesc = desc;

        if (desc.StartsWith("[") && desc.Contains("]"))
        {
            var closingIdx = desc.IndexOf("]");
            var bracketContent = desc.Substring(1, closingIdx - 1).Trim();
            cleanDesc = desc.Substring(closingIdx + 1).Trim();

            var parts = bracketContent.Split(new[] { '>', '/', '|' }, StringSplitOptions.RemoveEmptyEntries)
                                      .Select(p => p.Trim())
                                      .ToArray();
            if (parts.Length > 0) { cat = parts[0]; }
            if (parts.Length > 1) { subcat = parts[1]; }
        }

        var lowerCat = cat.ToLower();
        var mainCategory = "Gestión";
        if (lowerCat.Contains("dato"))
        {
            mainCategory = "Datos";
        }
        else if (lowerCat.Contains("reporte") || lowerCat.Contains("informe") || lowerCat.Contains("estadistic"))
        {
            mainCategory = "Reportes";
        }
        else if (lowerCat.Contains("sistema") || lowerCat.Contains("seguridad") || lowerCat.Contains("admin"))
        {
            mainCategory = "Sistema";
        }
        else if (lowerCat.Contains("gestion") || lowerCat.Contains("gestión") || lowerCat.Contains("gesti"))
        {
            mainCategory = "Gestión";
        }
        else
        {
            var text = (name + " " + (role.Name ?? "") + " " + desc).ToLower();
            if (text.Contains("reporte") || text.Contains("informe") || text.Contains("estadistica") || text.Contains("auditoria") || text.Contains("balance") || text.Contains("resumen") || text.Contains("liquidac"))
            {
                mainCategory = "Reportes";
            }
            else if (text.Contains("comprobante") || text.Contains("usuario") || text.Contains("sistema") || text.Contains("admin") || text.Contains("rol") || text.Contains("permiso") || text.Contains("funcion") || text.Contains("función") || text.Contains("seguridad") || text.Contains("perfil"))
            {
                mainCategory = "Sistema";
            }
            else if (text.Contains("documento") || text.Contains("sucursal") || text.Contains("empresa") || text.Contains("tarjeta estancia") || text.Contains("moneda") || text.Contains("pais") || text.Contains("país") || text.Contains("provincia") || text.Contains("localidad") || text.Contains("rubro") || text.Contains("billetera") || text.Contains("cuenta corriente") || text.Contains("dato"))
            {
                mainCategory = "Datos";
            }
            else
            {
                mainCategory = "Gestión";
            }
        }

        if (string.IsNullOrWhiteSpace(subcat) && mainCategory == "Gestión")
        {
            var text = (name + " " + (role.Name ?? "") + " " + desc).ToLower();
            // Solo en Gestión se sugiere agrupación para los roles existentes de cupones
            if (text.Contains("cupon") || text.Contains("cupón") || text.Contains("puntos") || text.Contains("premio"))
            {
                subcat = "Cupones";
            }
        }

        return (mainCategory, subcat, cleanDesc);
    }
}
@{
    ViewData["Title"] = "Asignar Permisos y Roles Locales";
    var user = ViewBag.User as Usuario;
    var roles = ViewBag.Roles as List<CommonsRole> ?? new List<CommonsRole>();
    var assignedRoleIds = ViewBag.AssignedRoleIds as List<string> ?? new List<string>();

    var modDatos = new {
        Key = "datos",
        Title = "Datos",
        Description = "Tipos de documento, sucursales, empresas, monedas y cuentas corrientes.",
        RoleItems = new List<RoleHierarchyItem>()
    };
    var modGestion = new {
        Key = "gestion",
        Title = "Gestión",
        Description = "Marketing, cupones, cobranzas de tarjeta, promociones, catálogo y novedades.",
        RoleItems = new List<RoleHierarchyItem>()
    };
    var modReportes = new {
        Key = "reportes",
        Title = "Reportes",
        Description = "Métricas analíticas, informes periódicos y conciliación financiera.",
        RoleItems = new List<RoleHierarchyItem>()
    };
    var modSistema = new {
        Key = "sistema",
        Title = "Sistema",
        Description = "Administración de usuarios, comprobantes, roles locales y funciones de seguridad.",
        RoleItems = new List<RoleHierarchyItem>()
    };

    var leftModules = new[] { modDatos, modReportes, modSistema };
    var rightModules = new[] { modGestion };

    foreach (var r in roles)
    {
        var h = ParseRoleCategoryAndSubcat(r);
        var item = new RoleHierarchyItem {
            Role = r,
            Subcategory = h.Subcategory,
            CleanDescription = h.CleanDesc
        };

        if (h.Category == "Datos")
        {
            modDatos.RoleItems.Add(item);
        }
        else if (h.Category == "Reportes")
        {
            modReportes.RoleItems.Add(item);
        }
        else if (h.Category == "Sistema")
        {
            modSistema.RoleItems.Add(item);
        }
        else
        {
            modGestion.RoleItems.Add(item);
        }
    }

    var userNameDisplay = user?.UserName ?? "Usuario";
    var userEmailDisplay = !string.IsNullOrEmpty(user?.Mail)
        ? user.Mail
        : (!string.IsNullOrEmpty(user?.Email)
            ? user.Email
            : (user?.Personas != null && !string.IsNullOrEmpty(user.Personas.Email)
                ? user.Personas.Email
                : "Sin correo registrado"));
}


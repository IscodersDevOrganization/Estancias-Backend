@using Commons.Identity
@{
    ViewData["Title"] = "Modificar Funciones de Rol";
    var role = ViewBag.Role as CommonsRole;
    var functions = ViewBag.Functions as List<CommonsFunction> ?? new List<CommonsFunction>();
    var assignedFuncIds = ViewBag.AssignedFuncIds as List<string> ?? new List<string>();
}

<style>
    .assign-func-modal-wrap {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        color: #1e293b;
        padding: 4px;
    }

    .assign-func-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        margin-bottom: 20px;
        padding-bottom: 14px;
        border-bottom: 1px solid #f1f5f9;
    }

    .assign-func-header-left {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .assign-func-badge {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        background: #fdf2f8;
        border: 1px solid #fbcfe8;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #9d174d;
        font-size: 20px;
        flex-shrink: 0;
    }

    .assign-func-titles h3 {
        font-size: 18px;
        font-weight: 700;
        color: #0f172a;
        margin: 0;
        line-height: 1.25;
    }

    .assign-func-titles p {
        font-size: 12.5px;
        color: #64748b;
        margin: 2px 0 0 0;
    }

    .assign-func-titles p strong {
        color: #1e293b;
    }

    .assign-func-close-btn {
        background: transparent;
        border: none;
        font-size: 24px;
        line-height: 1;
        color: #94a3b8;
        cursor: pointer;
        padding: 4px 8px;
        border-radius: 6px;
        transition: all 0.15s ease;
    }

    .assign-func-close-btn:hover {
        color: #0f172a;
        background: #f1f5f9;
    }

    /* Toolbar */
    .assign-func-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 14px;
    }

    .assign-func-search-wrap {
        position: relative;
        flex: 1;
        max-width: 320px;
    }

    .assign-func-search-wrap .fa-search {
        position: absolute;
        left: 11px;
        top: 50%;
        transform: translateY(-50%);
        color: #94a3b8;
        font-size: 13px;
        pointer-events: none;
    }

    .assign-func-search-input {
        width: 100%;
        height: 34px !important;
        padding: 6px 12px 6px 32px !important;
        font-size: 12.5px !important;
        border: 1px solid #e2e8f0 !important;
        border-radius: 8px !important;
        background: #ffffff !important;
        color: #1e293b !important;
        outline: none !important;
    }

    .assign-func-search-input:focus {
        border-color: #3c8dbc !important;
        box-shadow: 0 0 0 2px rgba(60, 141, 188, 0.15) !important;
    }

    .btn-toggle-all-funcs {
        background: #f1f5f9;
        border: 1px solid #e2e8f0;
        color: #475569;
        border-radius: 6px;
        font-size: 11.5px;
        font-weight: 600;
        padding: 5px 12px;
        cursor: pointer;
        white-space: nowrap;
        transition: all 0.15s ease;
    }

    .btn-toggle-all-funcs:hover {
        background: #e2e8f0;
        color: #1e293b;
    }

    /* Functions List */
    .assign-func-list-container {
        max-height: 420px;
        overflow-y: auto;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 8px;
        background: #f8fafc;
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .assign-func-item-row {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 9px 12px;
        display: flex;
        align-items: flex-start;
        gap: 12px;
        cursor: pointer;
        transition: all 0.15s ease;
        user-select: none;
    }

    .assign-func-item-row:hover {
        border-color: #cbd5e1;
        background: #ffffff;
    }

    .assign-func-item-row.is-selected {
        background: #eff6ff !important;
        border-color: #93c5fd !important;
    }

    .assign-func-chk {
        width: 17px;
        height: 17px;
        border-radius: 4px;
        margin-top: 2px !important;
        cursor: pointer;
        accent-color: #2563eb;
    }

    .assign-func-details {
        flex: 1;
        min-width: 0;
    }

    .assign-func-name {
        font-size: 13px;
        font-weight: 600;
        color: #1e293b;
        margin-bottom: 2px;
    }

    .assign-func-item-row.is-selected .assign-func-name {
        color: #1d4ed8;
    }

    .assign-func-desc {
        font-size: 11.5px;
        color: #64748b;
        margin-bottom: 4px;
    }

    .assign-func-routes-wrap {
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
    }

    .assign-func-route-pill {
        font-family: monospace;
        font-size: 10px;
        background: #f1f5f9;
        color: #475569;
        border: 1px solid #e2e8f0;
        padding: 1px 6px;
        border-radius: 4px;
    }

    /* Footer */
    .assign-func-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 16px;
        border-top: 1px solid #f1f5f9;
        margin-top: 18px;
    }

    .assign-func-count {
        font-size: 12.5px;
        color: #64748b;
    }

    .assign-func-count strong {
        color: #0f172a;
        font-weight: 700;
    }

    .assign-func-actions {
        display: inline-flex;
        align-items: center;
        gap: 10px;
    }

    .assign-func-actions .btn {
        border-radius: 3px !important;
        font-weight: 500 !important;
        font-size: 12px !important;
        line-height: 1.5 !important;
        padding: 6px 18px !important;
    }
</style>

<div class="assign-func-modal-wrap" id="assignFuncRoot">
    <form asp-action="_AssignFunctions" asp-controller="SecurityRoles" method="post" id="formAssignFunctions">
        <input type="hidden" name="roleId" value="@role?.Id" />

        <!-- Header -->
        <div class="assign-func-header">
            <div class="assign-func-header-left">
                <div class="assign-func-badge">
                    <i class="fa fa-key"></i>
                </div>
                <div class="assign-func-titles">
                    <h3>Funciones Asignadas al Rol</h3>
                    <p>Rol: <strong>@role?.ShowName</strong> — Seleccione las funciones y permisos habilitados.</p>
                </div>
            </div>
            <button type="button" class="assign-func-close-btn" data-dismiss="modal" title="Cerrar">&times;</button>
        </div>

        <!-- Toolbar -->
        <div class="assign-func-toolbar">
            <div class="assign-func-search-wrap">
                <i class="fa fa-search"></i>
                <input type="text" id="filterFunctionsInput" class="assign-func-search-input" placeholder="Filtrar funciones o rutas..." oninput="filterFunctionsLive(this.value)">
            </div>
            <button type="button" class="btn-toggle-all-funcs" id="btnToggleAllFuncs" onclick="toggleAllFunctions()">
                Marcar todas
            </button>
        </div>

        <!-- List -->
        <div class="assign-func-list-container" id="functionsContainer">
            @if (functions.Count == 0)
            {
                <div style="text-align: center; padding: 20px; color: #94a3b8; font-style: italic;">
                    No hay funciones registradas en el sistema.
                </div>
            }
            else
            {
                @foreach (var func in functions)
                {
                    var isChecked = assignedFuncIds.Contains(func.Id);
                    <div class="assign-func-item-row @(isChecked ? "is-selected" : "")" data-func-text="@((func.Name ?? "") + " " + (func.Description ?? "") + " " + (func.RoutesJson ?? "")).ToLower()" onclick="handleFuncRowClick(this, event)">
                        <input type="checkbox" name="selectedFunctionIds" value="@func.Id" @(isChecked ? "checked" : "") class="assign-func-chk" onclick="event.stopPropagation(); onFuncCheckboxToggled(this);" />
                        <div class="assign-func-details">
                            <div class="assign-func-name">@func.Name</div>
                            @if (!string.IsNullOrEmpty(func.Description))
                            {
                                <div class="assign-func-desc">@func.Description</div>
                            }
                            @{
                                var routesList = new List<string>();
                                if (!string.IsNullOrEmpty(func.RoutesJson))
                                {
                                    var raw = func.RoutesJson.Trim();
                                    if (raw.StartsWith("[") && raw.EndsWith("]"))
                                    {
                                        try { routesList = Newtonsoft.Json.JsonConvert.DeserializeObject<List<string>>(raw); } catch { }
                                    }
                                    if (!routesList.Any())
                                    {
                                        routesList = raw.Split(new[] { ',', ';', '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries)
                                                         .Select(r => r.Trim())
                                                         .Where(r => !string.IsNullOrEmpty(r))
                                                         .ToList();
                                    }
                                }
                                if (routesList.Any())
                                {
                                    <div class="assign-func-routes-wrap">
                                        @foreach (var route in routesList)
                                        {
                                            <span class="assign-func-route-pill">@route</span>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    </div>
                }
            }
        </div>

        <!-- Footer -->
        <div class="assign-func-footer">
            <div class="assign-func-count">
                <strong id="lblFuncsCount">@assignedFuncIds.Count</strong> función(es) seleccionada(s)
            </div>
            <div class="assign-func-actions">
                <button type="button" class="btn btn-default btn-sm" data-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary btn-sm">Guardar Cambios</button>
            </div>
        </div>
    </form>
</div>

<script>
    $(function () {
        var $modal = $('#assignFuncRoot').closest('.modal');
        if ($modal.length > 0) {
            $modal.find('.modal-header').hide();
            $modal.find('.modal-footer').hide();
            $modal.find('.modal-dialog').addClass('modal-lg').css({
                'max-width': '800px',
                'width': '90%',
                'margin': '30px auto'
            });
            $modal.find('.modal-body').css({
                'padding': '24px 28px',
                'background': '#ffffff',
                'border-radius': '14px'
            });
            $modal.find('.modal-content').css({
                'border-radius': '14px',
                'border': '1px solid #e2e8f0',
                'box-shadow': '0 25px 50px -12px rgba(0, 0, 0, 0.25)'
            });
        }

        updateFuncsCounter();
    });

    function handleFuncRowClick(rowElem, evt) {
        if ($(evt.target).is('input[type="checkbox"]')) return;
        var $chk = $(rowElem).find('input.assign-func-chk');
        $chk.prop('checked', !$chk.prop('checked'));
        onFuncCheckboxToggled($chk[0]);
    }

    function onFuncCheckboxToggled(chkElem) {
        var $chk = $(chkElem);
        var $row = $chk.closest('.assign-func-item-row');
        if ($chk.is(':checked')) {
            $row.addClass('is-selected');
        } else {
            $row.removeClass('is-selected');
        }
        updateFuncsCounter();
    }

    function toggleAllFunctions() {
        var $visibleRows = $('.assign-func-item-row:visible');
        if ($visibleRows.length === 0) return;

        var allChecked = true;
        $visibleRows.each(function () {
            if (!$(this).find('input.assign-func-chk').is(':checked')) {
                allChecked = false;
                return false;
            }
        });

        var newState = !allChecked;
        $visibleRows.each(function () {
            var $row = $(this);
            var $chk = $row.find('input.assign-func-chk');
            $chk.prop('checked', newState);
            if (newState) {
                $row.addClass('is-selected');
            } else {
                $row.removeClass('is-selected');
            }
        });

        updateFuncsCounter();
    }

    function updateFuncsCounter() {
        var total = $('input.assign-func-chk:checked').length;
        $('#lblFuncsCount').text(total);

        var $visible = $('.assign-func-item-row:visible input.assign-func-chk');
        if ($visible.length > 0 && $visible.filter(':checked').length === $visible.length) {
            $('#btnToggleAllFuncs').text('Desmarcar todas');
        } else {
            $('#btnToggleAllFuncs').text('Marcar todas');
        }
    }

    function filterFunctionsLive(query) {
        var q = (query || '').trim().toLowerCase();
        $('.assign-func-item-row').each(function () {
            var text = $(this).data('func-text') || '';
            if (!q || text.indexOf(q) !== -1) {
                $(this).show();
            } else {
                $(this).hide();
            }
        });
        updateFuncsCounter();
    }
</script>

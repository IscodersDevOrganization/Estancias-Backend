                    </div>
                </div>
            </div>

        </div>

        <!-- 5. Floating / Sticky Bottom Actions Bar -->
        <div class="client-sticky-footer">
            <div class="footer-client-info">
                <i class="fa fa-info-circle text-primary" style="font-size: 16px;"></i>
                <span>Completando ficha de: <strong>Nuevo Cliente</strong></span>
            </div>
            <div class="footer-actions">
                <a asp-action="Index" class="btn-modern btn-modern-default">
                    <i class="fa fa-times"></i> Cancelar
                </a>
                <button type="submit" class="btn-modern btn-modern-primary">
                    <i class="fa fa-check"></i> Crear Cliente
                </button>
            </div>
        </div>
    </form>
</div>

<script>
    // Manejo de switches modernos y tarjetas interactivas
    $(document).on('click', '.toggle-option-card', function (e) {
        // Si el click fue directamente sobre el checkbox del switch, el navegador ya realiza el toggle
        if ($(e.target).is('.modern-switch-input')) {
            return;
        }
        var $checkbox = $(this).find('.modern-switch-input');
        if ($checkbox.length) {
            $checkbox.prop('checked', !$checkbox.prop('checked')).trigger('change');
        }
    });

    $(document).on('change', '.modern-switch-input', function () {
        var isChecked = this.checked;
        $(this).closest('.toggle-option-card').toggleClass('is-active', isChecked);
    });

    $(document).ready(function () {
        // Sincronizar estado visual de los switches según el valor cargado del modelo
        $('.modern-switch-input').each(function () {
            $(this).closest('.toggle-option-card').toggleClass('is-active', this.checked);
        });

        // Asegurar refresco y renderizado perfecto de bootstrap-select
        if ($.fn.selectpicker) {
            $('.client-edit-container select:not(#CodeudorSelect):not(#DependeDeSelect)').selectpicker('refresh');
        }

        // Cascade dinámica Provincia -> Localidad
        $('#Provincia_Id').on('change', function () {
            var provId = $(this).val();
            if (!provId) return;

            $.ajax({
                url: "/Core/Clientes/SelectLocalidades",
                data: { id: provId },
                type: "POST",
                success: function (data) {
                    $('#Localidad_Id').empty().html(data);
                    if ($.fn.selectpicker) {
                        $('#Localidad_Id').selectpicker('refresh');
                    }
                }
            });
        });

        // Limpiar cualquier envoltura o botón de bootstrap-select en los campos con Select2
        $('#selectorCodeudor, #selectorDependeDe').each(function () {
            var $wrapper = $(this);
            var $select = $wrapper.find('select');
            if ($select.parent().hasClass('bootstrap-select')) {
                $select.siblings().remove();
                $select.unwrap();
            }
            $wrapper.find('.bootstrap-select').hide();
            $select.show();
        });

        // Inicializar Select2 para Codeudor
        $("#CodeudorSelect").select2({
            width: '100%',
            language: {
                inputTooShort: function () { return "Ingrese al menos 3 caracteres."; },
                errorLoading: function () { return "Error al cargar los clientes."; },
                noResults: function () { return "No se encontraron clientes."; },
                searching: function () { return "Buscando..."; }
            },
            ajax: {
                url: "/Core/Clientes/ClienteCombo",
                dataType: 'json',
                delay: 250,
                data: function (params) {
                    return {
                        term: params.term
                    };
                },
                processResults: function (data) {
                    return { results: data };
                }
            },
            placeholder: 'Seleccione un Codeudor (opcional)',
            allowClear: true,
            minimumInputLength: 3
        });

        // Inicializar Select2 para DependeDe
        $("#DependeDeSelect").select2({
            width: '100%',
            language: {
                inputTooShort: function () { return "Ingrese al menos 3 caracteres."; },
                errorLoading: function () { return "Error al cargar los clientes."; },
                noResults: function () { return "No se encontraron clientes."; },
                searching: function () { return "Buscando..."; }
            },
            ajax: {
                url: "/Core/Clientes/ClienteCombo",
                dataType: 'json',
                delay: 250,
                data: function (params) {
                    return {
                        term: params.term
                    };
                },
                processResults: function (data) {
                    return { results: data };
                }
            },
            placeholder: 'Seleccione el Titular (opcional)',
            allowClear: true,
            minimumInputLength: 3
        });

        // Ocultar cualquier botón residual de bootstrap-select
        $("#selectorCodeudor .bootstrap-select, #selectorDependeDe .bootstrap-select").hide();

        // Cambiar pestañas suavemente y mantener la pestaña activa
        $('.client-tab-link').on('click', function (e) {
            e.preventDefault();
            $('.client-tab-link').removeClass('active');
            $(this).addClass('active');
            var target = $(this).attr('href');
            $('.tab-content .tab-pane').removeClass('active');
            $(target).addClass('active');

            if (target === '#tab-relaciones') {
                $('#CodeudorSelect, #DependeDeSelect').trigger('change.select2');
            }
        });

        // Si hay errores de validación, activar automáticamente la pestaña que contenga el campo con error
        $('#formCrearCliente').on('submit', function () {
            setTimeout(function () {
                var firstError = $('.field-validation-error, .input-validation-error').first();
                if (firstError.length) {
                    var tabPane = firstError.closest('.tab-pane');
                    if (tabPane.length) {
                        var tabId = tabPane.attr('id');
                        $('.client-tab-link[href="#' + tabId + '"]').trigger('click');
                        firstError.focus();
                    }
                }
            }, 100);
        });
    });
</script>

@{
    Layout = null;
}

<form asp-action="Importar" asp-antiforgery="true" enctype="multipart/form-data" method="post">
    <div class="modal-body">
        <div class="form-group">
            <label>Seleccionar archivo (Excel/CSV)</label>
            <input type="file" name="archivo" class="form-control" accept=".xlsx,.csv" required />
            <small class="text-muted">Formato esperado: DNI, NombreCompleto, Código de Categoría.</small>
        </div>

        <div class="alert alert-info" style="margin-top: 10px; font-size: 12px; margin-bottom: 5px;">
            <i class="fa fa-info-circle"></i> <strong>Importante:</strong> En la columna de categoría del archivo Excel/CSV debe ingresar el <strong>Código</strong> de la categoría registrada en <em>Categorías de Usuario</em>.
        </div>

        <div class="form-group mt-3">
            <a href="#" onclick="window.location.href='/Core/PreRegistroCategorias/DescargarPlantilla'; return false;" class="btn btn-link">
                <i class="fa fa-download"></i> Descargar plantilla de ejemplo
            </a>
        </div>
    </div>
    
    <div class="modal-footer">
        <a class="btn btn-default" data-dismiss="modal">Cancelar</a>
        <input type="submit" value="Importar" class="btn btn-success pull-right" />
    </div>
</form>

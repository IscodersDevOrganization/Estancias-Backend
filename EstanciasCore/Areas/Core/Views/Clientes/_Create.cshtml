                                        <input asp-for="ReferenciaA.Vinculo" class="form-control-modern input-with-icon" placeholder="Ej: Hermano, Cónyuge, Amigo" />
                                    </div>
                                    <span asp-validation-for="ReferenciaA.Vinculo" class="text-danger small"></span>
                                </div>

                                <div class="form-group-modern" style="margin-bottom: 0;">
                                    <label asp-for="ReferenciaA.Telefono" class="form-label-modern">Teléfono de Contacto</label>
                                    <div class="input-icon-wrapper">
                                        <i class="fa fa-phone input-icon-left"></i>
                                        <input asp-for="ReferenciaA.Telefono" class="form-control-modern input-with-icon" placeholder="Ej: 11 4455 6677" />
                                    </div>
                                    <span asp-validation-for="ReferenciaA.Telefono" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Referencia B -->
                        <div class="col-md-6">
                            <div class="reference-card">
                                <div class="reference-card-header">
                                    <span class="reference-badge">Referencia 2</span>
                                    <strong style="color: #0f172a; font-size: 14px;">Contacto Secundario</strong>
                                </div>

                                <div class="form-group-modern">
                                    <label asp-for="ReferenciaB.NombreCompleto" class="form-label-modern">Nombre y Apellido</label>
                                    <div class="input-icon-wrapper">
                                        <i class="fa fa-user-o input-icon-left"></i>
                                        <input asp-for="ReferenciaB.NombreCompleto" class="form-control-modern input-with-icon" placeholder="Nombre completo" />
                                    </div>
                                    <span asp-validation-for="ReferenciaB.NombreCompleto" class="text-danger small"></span>
                                </div>

                                <div class="form-group-modern">
                                    <label asp-for="ReferenciaB.Vinculo" class="form-label-modern">Vínculo / Parentesco</label>
                                    <div class="input-icon-wrapper">
                                        <i class="fa fa-link input-icon-left"></i>
                                        <input asp-for="ReferenciaB.Vinculo" class="form-control-modern input-with-icon" placeholder="Ej: Compañero de trabajo, Tío" />
                                    </div>
                                    <span asp-validation-for="ReferenciaB.Vinculo" class="text-danger small"></span>
                                </div>

                                <div class="form-group-modern" style="margin-bottom: 0;">
                                    <label asp-for="ReferenciaB.Telefono" class="form-label-modern">Teléfono de Contacto</label>
                                    <div class="input-icon-wrapper">
                                        <i class="fa fa-phone input-icon-left"></i>
                                        <input asp-for="ReferenciaB.Telefono" class="form-control-modern input-with-icon" placeholder="Ej: 11 5566 7788" />

@{
    var title = ViewBag.Title ?? ViewData["Title"] ?? "";
    var subtitle = ViewBag.SubTitle ?? ViewData["SubTitle"] ?? "";
}

<div class="page-header-row page-header-global">
    <div class="page-header-left">
        <div class="page-header-title-wrap">
            <h1 class="modern-page-title">@title</h1>
        </div>
        @if (subtitle != null && !string.IsNullOrWhiteSpace(subtitle.ToString()))
        {
            <p class="modern-page-subtitle">@subtitle</p>
        }
    </div>
</div>

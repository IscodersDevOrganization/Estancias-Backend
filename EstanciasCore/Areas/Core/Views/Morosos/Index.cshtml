@model List<DAL.Models.Morosos>

@{
    ViewData["Title"] = "Listado de Morosos";
}

<div class="box box-info">
    <div class="box-header with-border filtro-grilla">
        <span class="txt-titulo-box">Listado de Morosos</span>
        <div class="input-group input-group-sm pull-right" style="max-width: 450px;">
            <a onclick="verHistorial()" class="btn btn-warning btn-sm" title="Historial de Cargas" style="margin-right: 5px;">
                <i class="fa fa-history"><span class="hidden-xs"> Historial</span></i>
            </a>
            <a href="/Core/Morosos/DescargarListadoVigente" class="btn btn-primary btn-sm" title="Descargar Listado Vigente" style="margin-right: 5px;">
                <i class="fa fa-download"><span class="hidden-xs"> Descargar Listado</span></i>
            </a>
            <a onclick="importarMorosos()" class="btn btn-success btn-sm" title="Importar Archivo">
                <i class="fa fa-upload"><span class="hidden-xs"> Importar</span></i>
            </a>
        </div>
    </div>
    <div class="box-body">

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }
        @if (TempData["Warning"] != null)
        {
            <div class="alert alert-warning">@TempData["Warning"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        <div id="loadingMorosos" class="text-center" style="padding: 40px 0;">
            <i class="fa fa-spinner fa-spin fa-3x fa-fw text-info"></i>
            <p style="margin-top: 10px; color: #666; font-weight: 500;">Cargando listado de morosos...</p>
        </div>

        <table id="listadoMorosos" class="table table-hover table-bordered table-responsive borde_interno" style="display: none; width: 100%;">
            <thead>
                <tr>
                    <th>DNI</th>
                    <th>Nombre y Apellido</th>
                    <th>Fecha de Carga</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.DNI)</td>
                        <td>@Html.DisplayFor(modelItem => item.NombreCompleto)</td>
                        <td>@item.FechaCarga.ToString("dd/MM/yyyy HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<modal title="Importar Morosos" callback-modal="true" function="importarMorosos" load-url="/Core/Morosos/_Importar/" size="Medium"></modal>
<modal title="Historial de Cargas de Morosos" callback-modal="true" function="verHistorial" load-url="/Core/Morosos/_VerHistorial/" size="Large"></modal>

<script>
    $(document).ready(function () {
        $('#listadoMorosos').DataTable({
            "columnDefs": [
                { "width": "25%", "targets": 0 },
                { "width": "50%", "targets": 1 },
                { "width": "25%", "targets": 2 }
            ],
            "language": {
                'url': '@Url.Content("~/lib/arg.json")'
            },
            "initComplete": function () {
                $('#loadingMorosos').hide();
                $('#listadoMorosos').fadeIn(150);
            }
        });
    });
</script>

@if (TempData["ErroresImportacion"] != null)
{
    var erroresJson = TempData["ErroresImportacion"].ToString();
    <script>
        $(document).ready(function () {
            try {
                var errores = @Html.Raw(erroresJson);
                if (errores && errores.length > 0) {
                    var htmlList = '<div style="max-height: 250px; overflow-y: auto; text-align: left; background: #fff3cd; color: #856404; padding: 12px; border: 1px solid #ffeeba; border-radius: 4px; font-size: 13px;">';
                    htmlList += '<ul style="margin: 0; padding-left: 20px;">';
                    for (var i = 0; i < errores.length; i++) {
                        htmlList += '<li style="margin-bottom: 4px;">' + $('<div>').text(errores[i]).html() + '</li>';
                    }
                    htmlList += '</ul></div>';

                    Swal.fire({
                        title: 'Registros rechazados u omitidos (' + errores.length + ')',
                        html: htmlList,
                        icon: 'warning',
                        confirmButtonText: 'Entendido',
                        confirmButtonColor: '#f39c12',
                        width: '600px'
                    });
                }
            } catch (e) { }
        });
    </script>
}

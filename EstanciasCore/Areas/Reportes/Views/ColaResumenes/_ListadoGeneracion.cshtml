@model List<DAL.DTOs.Reportes.GeneracionItemDTO>
@using DAL.Models
@{
    Layout = null;
    int maximo = ViewBag.MaximoFilas ?? 5000;

    string Recortar(string texto, int largo) =>
        string.IsNullOrEmpty(texto) ? "" : (texto.Length <= largo ? texto : texto.Substring(0, largo) + "…");
}

@if (Model.Count >= maximo)
{
    <div class="alert alert-warning">Se muestran los últimos @maximo registros. Usá los filtros para acotar la búsqueda.</div>
}

<div class="table-responsive">
    <table id="tablaGeneracion" class="table table-hover modern-table" style="width: 100%;">
        <thead>
            <tr>
                <th>Cliente</th>
                <th>DNI</th>
                <th>Tarjeta</th>
                <th>Estado</th>
                <th class="text-center">Intentos</th>
                <th>Último intento</th>
                <th>Error</th>
                <th class="text-center" style="width: 60px;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var g in Model)
            {
                <tr>
                    <td><span class="text-usuario-email">@g.Email</span></td>
                    <td><span class="badge-tarjeta-pill">@g.NroDocumento</span></td>
                    <td><span class="badge-tarjeta-pill">@g.NroTarjeta</span></td>
                    <td data-order="@g.Estado">
                        @if (g.Estado == EstadosGeneracion.Generado)
                        {
                            <span class="badge-pill badge-pill-green">Generado</span>
                        }
                        else
                        {
                            <span class="badge-pill badge-pill-red">Con error</span>
                        }
                    </td>
                    <td class="text-center">@g.Intentos</td>
                    <td data-order="@g.FechaUltimoIntento.ToString("yyyyMMddHHmmss")" style="white-space: nowrap;">@g.FechaUltimoIntento.ToString("dd/MM/yyyy HH:mm")</td>
                    <td style="max-width: 420px; word-break: break-word;">
                        @if (!string.IsNullOrEmpty(g.CodigoError))
                        {
                            <span class="badge-pill badge-pill-red" style="margin-bottom: 3px;">@g.CodigoError</span>
                        }
                        @if (!string.IsNullOrEmpty(g.Mensaje))
                        {
                            <div style="font-size: 11.5px; color: #64748b;" title="@Recortar(g.Mensaje, 1500)">@Recortar(g.Mensaje, 160)</div>
                        }
                    </td>
                    <td class="text-center">
                        <a onclick="verGeneracion(@g.Id)" class="btn btn-default btn-xs" title="Ver detalle completo"><i class="fa fa-eye"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<script>
    $('#tablaGeneracion').DataTable({
        "order": [],
        "pageLength": 25,
        "stateSave": false,
        "responsive": false,
        "autoWidth": false,
        // commons_site.js fuerza render.text() en todas las columnas (escapa el HTML);
        // acá las celdas traen pills y botones, así que se muestran tal cual.
        "columnDefs": [{ "targets": "_all", "render": function (data) { return data; } }],
        "language": { 'url': '@Url.Content("~/lib/arg.json")' }
    });
</script>

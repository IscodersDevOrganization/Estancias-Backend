    }

    /* Footer */
    .role-form-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding-top: 16px;
        border-top: 1px solid #f1f5f9;
        margin-top: 10px;
    }

    .role-form-footer-left {
        font-size: 12px;
        color: #64748b;
    }

    .role-form-footer-left strong {
        color: #0f172a;
        font-weight: 700;
    }

    .role-form-footer-right {
        display: flex;

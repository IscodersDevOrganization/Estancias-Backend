@model IEnumerable<DAL.Models.SolicitudDeTarjeta>

@{
    ViewData["Title"] = "Solicitudes de Tarjeta";
}

<div class="box box-info">
    <div class="box-header with-border filtro-grilla">
        <span class="txt-titulo-box">Listado de Solicitudes de Tarjeta</span>
        <div class="input-group input-group-sm pull-right" style="max-width: 300px;">
            <a href="javascript:void(0)" onclick="nuevaSolicitud()" class="btn btn-info btn-sm" title="Nueva Solicitud">
                <i class="fa fa-plus"><span class="hidden-xs"> Nuevo</span></i>
            </a>
        </div>
    </div>

    <div class="box-body">

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible">
                <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
                @TempData["Success"]
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible">
                <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
                @TempData["Error"]
            </div>
        }

        <table id="listadoSolicitudes" class="table table-hover table-bordered table-responsive borde_interno">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Apellido</th>
                    <th>DNI</th>
                    <th>Teléfono</th>
                    <th>Email</th>
                    <th>Fecha Solicitud</th>
                    <th class="text-center">Estado</th>
                    <th class="text-center">Nro. de Tarjeta</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var estadoId = item.Estado != null ? item.Estado.Id : 1;
                    <tr data-id="@item.Id" data-estado-id="@estadoId">
                        <td>@Html.DisplayFor(modelItem => item.Nombre)</td>
                        <td>@Html.DisplayFor(modelItem => item.Apellido)</td>
                        <td>@Html.DisplayFor(modelItem => item.DNI)</td>
                        <td>@Html.DisplayFor(modelItem => item.Telefono)</td>
                        <td>@Html.DisplayFor(modelItem => item.Email)</td>
                        <td data-order="@item.FechaSolicitud.ToString("yyyyMMddHHmmss")">@item.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="text-center">
                            @if (estadoId == 2)
                            {
                                <span class="label label-success" style="background-color: #00a65a; font-size: 11px; padding: 4px 8px;">Aprobada</span>
                            }
                            else if (estadoId == 3)
                            {
                                <span class="label label-danger" style="background-color: #dd4b39; font-size: 11px; padding: 4px 8px;">Rechazada</span>
                            }
                            else if (estadoId == 4)
                            {
                                <span class="label label-warning" style="background-color: #f39c12; font-size: 11px; padding: 4px 8px;">Nueva Revisión</span>
                            }
                            else
                            {
                                <span class="label label-primary" style="background-color: #3c8dbc; font-size: 11px; padding: 4px 8px;">Pendiente</span>
                            }
                        </td>
                        <td class="text-center">
                            @(string.IsNullOrEmpty(item.NumeroTarjeta) ? "-" : item.NumeroTarjeta)
                        </td>
                        <td class="text-center">
                            <a href="javascript:void(0)" onclick="verAdjuntos(@item.Id)" title="Ver Adjuntos" class="btn btn-info btn-xs"><i class="fa fa-image"></i></a>
                            @if (estadoId == 1 || estadoId == 4)
                            {
                                <a href="javascript:void(0)" onclick="editarSolicitud(@item.Id)" title="Editar" class="btn btn-primary btn-xs"><i class="fa fa-edit"></i></a>
                                <a href="javascript:void(0)" onclick="aprobarSolicitud(@item.Id)" title="Aprobar y Asignar Tarjeta" class="btn btn-success btn-xs"><i class="fa fa-check"></i></a>
                                <a href="javascript:void(0)" onclick="confirmarNuevaRevision(event, '/Core/SolicitudDeTarjeta/NuevaRevision/@item.Id')" title="Solicitar Nueva Revisión" class="btn btn-warning btn-xs" style="background-color: #f39c12; border-color: #e08e0b;"><i class="fa fa-refresh"></i></a>
                                <a href="javascript:void(0)" onclick="confirmarRechazar(event, '/Core/SolicitudDeTarjeta/Rechazar/@item.Id')" title="Rechazar Solicitud" class="btn btn-danger btn-xs"><i class="fa fa-times"></i></a>
                                <a href="javascript:void(0)" onclick="confirmarEliminar(event, '/Core/SolicitudDeTarjeta/Delete/@item.Id')" title="Borrar" class="btn btn-default btn-xs" style="color: #dd4b39;"><i class="fa fa-trash-o"></i></a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<modal title="Nueva Solicitud de Tarjeta" callback-modal="true" function="nuevaSolicitud" load-url="/Core/SolicitudDeTarjeta/_Create/" size="Medium"></modal>
<modal title="Edición de Solicitud de Tarjeta" callback-modal="true" function="editarSolicitud" load-url="/Core/SolicitudDeTarjeta/_Edit/" size="Medium"></modal>
<modal title="Aprobar Solicitud de Tarjeta" callback-modal="true" function="aprobarSolicitud" load-url="/Core/SolicitudDeTarjeta/_Aprobar/" size="Medium"></modal>
<modal title="Datos y Adjuntos de Solicitud de Tarjeta" callback-modal="true" function="verAdjuntos" load-url="/Core/SolicitudDeTarjeta/_VerAdjuntos/" size="Large"></modal>

<script>
    var tableSolicitudes = null;
    var storageFiltroKey = 'portal_flt_' + window.location.pathname.toLowerCase().replace(/\/$/, '') + '_filtroestado';

    function confirmarRechazar(e, url) {
        if (e && e.preventDefault) e.preventDefault();
        var $tr = $(e.target).closest('tr');

        Swal.fire({
            title: "¿Desea rechazar esta solicitud?",
            text: "Se enviará un correo informando que no cumple con los requisitos mínimos para dar el alta.",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#dd4b39",
            cancelButtonColor: "#3085d6",
            confirmButtonText: "Sí, Rechazar",
            cancelButtonText: "Cancelar"
        }).then((result) => {
            if (result.isConfirmed) {
                Swal.fire({
                    title: "Procesando rechazo...",
                    text: "Por favor espere mientras se envía el correo.",
                    allowOutsideClick: false,
                    didOpen: () => { Swal.showLoading(); }
                });

                $.ajax({
                    url: url,
                    type: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    success: function (res) {
                        if (res && res.success) {
                            $tr.attr('data-estado-id', '3');
                            $tr.find('td').eq(6).html('<span class="label label-danger" style="background-color: #dd4b39; font-size: 11px; padding: 4px 8px;">Rechazada</span>');
                            var id = $tr.attr('data-id');
                            $tr.find('td').eq(8).html('<a href="javascript:void(0)" onclick="verAdjuntos(' + id + ')" title="Ver Adjuntos" class="btn btn-info btn-xs"><i class="fa fa-image"></i></a>');

                            if (tableSolicitudes) {
                                tableSolicitudes.rows().invalidate().draw(false);
                            }

                            Swal.fire({
                                title: "¡Rechazada!",
                                text: res.message || "La solicitud fue rechazada correctamente.",
                                icon: "success",
                                timer: 2500,
                                showConfirmButton: false
                            });
                        } else {
                            Swal.fire("Error", (res && res.message) ? res.message : "No se pudo rechazar la solicitud.", "error");
                        }
                    },
                    error: function () {
                        Swal.fire("Error", "Ocurrió un error al procesar la solicitud.", "error");
                    }
                });
            }
        });
    }

    function confirmarNuevaRevision(e, url) {
        if (e && e.preventDefault) e.preventDefault();
        var $tr = $(e.target).closest('tr');

        Swal.fire({
            title: "¿Solicitar Nueva Revisión?",
            text: "Se enviará un correo solicitando la documentación necesaria para validar la solicitud y se cambiará su estado a 'Nueva Revisión'.",
            icon: "info",
            showCancelButton: true,
            confirmButtonColor: "#f39c12",
            cancelButtonColor: "#3085d6",
            confirmButtonText: "Sí, Solicitar Revisión",
            cancelButtonText: "Cancelar"
        }).then((result) => {
            if (result.isConfirmed) {
                Swal.fire({
                    title: "Solicitando nueva revisión...",
                    text: "Por favor espere mientras se envía la notificación.",
                    allowOutsideClick: false,
                    didOpen: () => { Swal.showLoading(); }
                });

                $.ajax({
                    url: url,
                    type: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    success: function (res) {
                        if (res && res.success) {
                            $tr.attr('data-estado-id', '4');
                            $tr.find('td').eq(6).html('<span class="label label-warning" style="background-color: #f39c12; font-size: 11px; padding: 4px 8px;">Nueva Revisión</span>');

                            if (tableSolicitudes) {
                                tableSolicitudes.rows().invalidate().draw(false);
                            }

                            Swal.fire({
                                title: "¡Nueva Revisión!",
                                text: res.message || "La solicitud fue puesta en Nueva Revisión.",
                                icon: "success",
                                timer: 2500,
                                showConfirmButton: false
                            });
                        } else {
                            Swal.fire("Error", (res && res.message) ? res.message : "No se pudo actualizar la solicitud.", "error");
                        }
                    },
                    error: function () {
                        Swal.fire("Error", "Ocurrió un error al solicitar nueva revisión.", "error");
                    }
                });
            }
        });
    }

    function confirmarEliminar(e, url) {
        if (e && e.preventDefault) e.preventDefault();
        var $tr = $(e.target).closest('tr');

        Swal.fire({
            title: "¿Está seguro?",
            text: "¿Desea borrar esta solicitud?",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#d33",
            cancelButtonColor: "#3085d6",
            confirmButtonText: "Borrar",
            cancelButtonText: "Cancelar"
        }).then((result) => {
            if (result.isConfirmed) {
                Swal.fire({
                    title: "Eliminando...",
                    allowOutsideClick: false,
                    didOpen: () => { Swal.showLoading(); }
                });

                $.ajax({
                    url: url,
                    type: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    success: function (res) {
                        if (res && res.success) {
                            if (tableSolicitudes) {
                                tableSolicitudes.row($tr).remove().draw(false);
                            } else {
                                $tr.remove();
                            }

                            Swal.fire({
                                title: "¡Eliminada!",
                                text: res.message || "Solicitud de tarjeta eliminada correctamente.",
                                icon: "success",
                                timer: 2000,
                                showConfirmButton: false
                            });
                        } else {
                            Swal.fire("Error", (res && res.message) ? res.message : "No se pudo eliminar la solicitud.", "error");
                        }
                    },
                    error: function () {
                        Swal.fire("Error", "Ocurrió un error al eliminar la solicitud.", "error");
                    }
                });
            }
        });
    }

    $(document).ready(function () {
        var savedFilter = sessionStorage.getItem(storageFiltroKey);
        if (savedFilter !== null) {
            try { savedFilter = JSON.parse(savedFilter); } catch(e) {}
        }

        tableSolicitudes = $('#listadoSolicitudes').DataTable({
            "order": [[5, "desc"]],
            "columnDefs": [
                { "orderable": false, "searchable": false, "className": "text-center", "targets": [7, 8] }
            ],
            "language": {
                'url': '@Url.Content("~/lib/arg.json")'
            },
            initComplete: function () {
                var filterHtml = `
                    <label style="margin-right: 15px; font-weight: normal; display: inline-block;">
                        Filtrar por Estado: 
                        <select id="filtroEstado" class="form-control input-sm" style="display: inline-block; width: auto; margin-left: 5px;">
                            <option value="">Todos los Estados</option>
                            <option value="1">Pendiente</option>
                            <option value="2">Aprobada</option>
                            <option value="3">Rechazada</option>
                            <option value="4">Nueva Revisión</option>
                        </select>
                    </label>
                `;
                $('#listadoSolicitudes_filter').prepend(filterHtml);

                if (savedFilter) {
                    $('#filtroEstado').val(savedFilter);
                    tableSolicitudes.draw(false);
                }
            }
        });

        // Filtro personalizado por EstadoId
        $.fn.dataTable.ext.search.push(
            function (settings, data, dataIndex) {
                if (!settings || !settings.nTable || settings.nTable.id !== 'listadoSolicitudes') {
                    return true;
                }
                var selectedEstado = $('#filtroEstado').val();
                if (!selectedEstado && savedFilter) {
                    selectedEstado = savedFilter;
                }
                if (!selectedEstado) {
                    return true;
                }
                var rowNode = tableSolicitudes.row(dataIndex).node();
                var rowEstadoId = $(rowNode).attr('data-estado-id');
                return rowEstadoId === selectedEstado;
            }
        );

        $(document).on('change', '#filtroEstado', function () {
            var val = $(this).val();
            savedFilter = val;
            if (val) {
                sessionStorage.setItem(storageFiltroKey, JSON.stringify(val));
            } else {
                sessionStorage.removeItem(storageFiltroKey);
            }
            tableSolicitudes.draw();
        });

        // Interceptar envío modal Aprobar Solicitud
        $(document).on('submit', 'form[action*="_Aprobar"]', function (e) {
            e.preventDefault();
            var form = $(this);
            var id = form.find('input[name="Id"]').val();
            var tarjeta = form.find('input[name="NumeroTarjeta"]').val();

            Swal.fire({
                title: "Aprobando solicitud...",
                text: "Por favor espere mientras se envía el correo.",
                allowOutsideClick: false,
                didOpen: () => { Swal.showLoading(); }
            });

            $.ajax({
                url: form.attr('action'),
                type: 'POST',
                data: form.serialize(),
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                success: function (res) {
                    if (res && res.success) {
                        form.closest('.modal').modal('hide');

                        var $row = $('#listadoSolicitudes tbody tr').filter(function () {
                            return $(this).attr('data-id') === String(id)
                                || $(this).find('a[onclick*="aprobarSolicitud(' + id + ')"]').length > 0;
                        });

                        if ($row.length) {
                            $row.attr('data-estado-id', '2');
                            $row.find('td').eq(6).html('<span class="label label-success" style="background-color: #00a65a; font-size: 11px; padding: 4px 8px;">Aprobada</span>');
                            $row.find('td').eq(7).text(res.numeroTarjeta || tarjeta || '-');
                            $row.find('td').eq(8).html('<a href="javascript:void(0)" onclick="verAdjuntos(' + id + ')" title="Ver Adjuntos" class="btn btn-info btn-xs"><i class="fa fa-image"></i></a>');

                            tableSolicitudes.rows().invalidate().draw(false);
                        }

                        Swal.fire({
                            title: "¡Aprobada!",
                            text: res.message || "La solicitud fue aprobada correctamente.",
                            icon: "success",
                            timer: 2500,
                            showConfirmButton: false
                        });
                    } else {
                        Swal.fire("Error", (res && res.message) ? res.message : "No se pudo aprobar la solicitud.", "error");
                    }
                },
                error: function () {
                    Swal.fire("Error", "Ocurrió un error al procesar la aprobación.", "error");
                }
            });
        });

        // Interceptar envío modal Editar Solicitud
        $(document).on('submit', 'form[action*="_Edit"]', function (e) {
            e.preventDefault();
            var form = $(this);
            var id = form.find('input[name="Id"]').val();

            Swal.fire({
                title: "Guardando cambios...",
                allowOutsideClick: false,
                didOpen: () => { Swal.showLoading(); }
            });

            $.ajax({
                url: form.attr('action'),
                type: 'POST',
                data: form.serialize(),
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                success: function (res) {
                    if (res && res.success) {
                        form.closest('.modal').modal('hide');

                        var $row = $('#listadoSolicitudes tbody tr').filter(function () {
                            return $(this).attr('data-id') === String(id)
                                || $(this).find('a[onclick*="editarSolicitud(' + id + ')"]').length > 0;
                        });

                        if ($row.length) {
                            if (res.nombre) $row.find('td').eq(0).text(res.nombre);
                            if (res.apellido) $row.find('td').eq(1).text(res.apellido);
                            if (res.dni) $row.find('td').eq(2).text(res.dni);
                            if (res.telefono) $row.find('td').eq(3).text(res.telefono);
                            if (res.email) $row.find('td').eq(4).text(res.email);

                            tableSolicitudes.rows().invalidate().draw(false);
                        }

                        Swal.fire({
                            title: "¡Actualizado!",
                            text: res.message || "Solicitud de tarjeta actualizada correctamente.",
                            icon: "success",
                            timer: 2000,
                            showConfirmButton: false
                        });
                    } else {
                        if (typeof res === 'string' && res.indexOf('<form') > -1) {
                            form.closest('.modal-body').html(res);
                            Swal.close();
                        } else {
                            Swal.fire("Error", (res && res.message) ? res.message : "Error al guardar los cambios.", "error");
                        }
                    }
                },
                error: function () {
                    Swal.fire("Error", "Ocurrió un error al guardar los cambios.", "error");
                }
            });
        });
    });
</script>

@using DAL.Models
@model Commons.Models.Page<DAL.Models.UsuariosCategorias>

<box-header title="Listado">
    <box-search update-div="tablaUsuariosCategorias">
        <div class="input-group input-group-sm pull-right" style="max-width: 300px;">
            <a onclick="nuevoUsuarioCategoria()" class="btn btn-info btn-sm">
                <i class="fa fa-plus"><span class="hidden-xs"> Nuevo</span></i>
            </a>
        </div>
    </box-search>
</box-header>
<box-body table="true">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>
                    Id
                </th>
                <th>
                    Nombre
                </th>
                <th>
                    Código
                </th>
                <th>
                    Color
                </th>
                <th>
                    Código Color
                </th>
                <th>
                    Orden
                </th>
                <th>
                    Activo
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items.OrderBy(x => x.Orden))
            {
                <tr>
                    <td>
                        @item.Id
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Nombre)
                    </td>
                    <td>
                        @item.Codigo
                    </td>
                 <td>
                     @item.Color
                </td>
                <td>
                     <span style="display:inline-block; width: 20px; height: 20px; background-color: @item.CodigoColor; border-radius: 50%; border: 1px solid #ccc; vertical-align: middle;"></span>
                     @item.CodigoColor
                 </td>
                <td>
                     @item.Orden
                 </td>
                <td>
                     @(item.Activo ? "Sí" : "No")
                 </td>                
                 <td>
                      <a onclick="editUsuarioCategoria(@item.Id)" title="Editar" class="btn btn-primary btn-xs"><i class="fa fa-file-text-o"></i></a>
                      <a onclick="cambiarOrdenUsuarioCategoria(@item.Id)" title="Cambiar Orden" class="btn btn-primary btn-xs"><i class="fa fa-sort-numeric-asc"></i></a>                      
                        @if (item.ImagenTarjeta != null)
                        {
                            <a onclick="imagen(@item.Id)" title="Editar Foto" class="btn btn-primary btn-xs"><i class="fa fa-image"></i></a>
                        }
                        else
                        {
                            <a onclick="imagen(@item.Id)" title="No ha ingresado Foto" class="btn btn-danger btn-xs">
                                <i class="fa fa-image"></i>
                                <i class="fa fa-exclamation"></i>
                            </a>
                        }
                      <a onclick="borrarUsuarioCategoria(@item.Id)" title="Borrar" class="btn btn-danger btn-xs"><i class="fa fa-trash"></i></a>
                 </td>
             </tr>
            }
        </tbody>
    </table>

</box-body>
<box-footer page-update-div="tablaUsuariosCategorias"></box-footer>
<modal title="Edición de Categoría de Usuario" function="editUsuarioCategoria" load-url="/Core/UsuarioCategorias/Update/" size="Medium"></modal>
<modal title="Nueva Categoría de Usuario" function="nuevoUsuarioCategoria" load-url="/Core/UsuarioCategorias/Create/" size="Medium"></modal>
<modal title="Cambiar Foto" function="imagen" load-url="/Core/UsuarioCategorias/_CambiarImagen/" size="Medium"></modal>


<script>

    borrarUsuarioCategoria = (id) => {
        Swal.fire({
            title: "¿Desea Borrar la Categoría?",
            showDenyButton: true,
            showCancelButton: true,
            showConfirmButton: false,
            confirmButtonText: "Save",
            cancelButtonText: "Cancelar",
            denyButtonText: `Borrar`
        }).then((result) => {
           if (result.isDenied) {
                $.ajax({
                    url: '/Core/UsuarioCategorias/Delete/' + id,
                    type: 'GET',
                    dataType: 'json',
                    success: function (response) {
                        if(response){
                            location.reload();
                        }else{
                            Swal.fire("Error al borrar.", "", "warning");
                        }
                    },
                    error: function (error) {
                        Swal.fire("Error al borrar.", "", "warning");
                    }
                });
            }
        });
    }

    cambiarOrdenUsuarioCategoria = (id) => {
        Swal.fire({
            title: '¿Modificar orden de la Categoría?',
            text: 'Ingrese un número de orden',
            input: 'text',
            showCancelButton: true,
            showConfirmButton: true,
            confirmButtonText: 'SI',
            confirmButtonColor: "#3085d6",
            cancelButtonColor: "#d33",
            icon: 'question',
            iconColor: 'LightSkyBlue',
            cancelButtonText: 'No',
        }).then(function (result) {
            if (result.isConfirmed) {
                if (result.value) {
                    $.ajax({
                        type: 'POST',
                        url: '/Core/UsuarioCategorias/ModificarOrden',
                        data: { Id: id, Orden: result.value },
                        success: function (data) {
                            Swal.fire({
                                title: 'Correcto!',
                                text: 'Se Modificó el Orden',
                                icon: 'success',
                                showConfirmButton: true,
                            }).then(function (result) {
                                window.location.href = '/Core/UsuarioCategorias/'
                            });
                        },
                        error: function (XHR) {
                            Swal.fire({
                                text: "Error " + XHR.status,
                                icon: 'error',
                                showConfirmButton: true,
                            });
                        }
                    })
                } else {
                    Swal.fire({
                        text: "Debe Ingresar un Orden",
                        icon: 'warning',
                        showConfirmButton: true,
                    });
                }
            }
        });
    }
</script>

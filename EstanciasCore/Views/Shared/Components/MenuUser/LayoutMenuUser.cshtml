@using Commons.Identity.Extensions
@using Commons.Identity.Services
@inject SignInService<Usuario> SignInManager

@if (SignInManager.IsSignedIn(User))
{
    var userName = User.Identity != null ? User.Identity.Name : "admin@admin.com";
    var userNick = User.GetUserName();
    var displayName = !string.IsNullOrEmpty(userNick) ? userNick : (userName == "admin@admin.com" ? "Super Admin" : userName);
    var initials = "SA";
    if (!string.IsNullOrEmpty(displayName))
    {
        var parts = displayName.Trim().Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2 && parts[0].Length > 0 && parts[1].Length > 0)
        {
            initials = ("" + parts[0][0] + parts[1][0]).ToUpper();
        }
        else if (displayName.Length >= 2)
        {
            initials = displayName.Substring(0, 2).ToUpper();
        }
    }

    <li class="dropdown user user-menu modern-user-menu">
        <a href="#" class="dropdown-toggle modern-user-toggle" data-toggle="dropdown">
            <div class="user-info-text hidden-xs">
                <span class="user-name">@displayName</span>
                <span class="user-email">@userName</span>
            </div>
            <div class="user-avatar-badge">@initials</div>
        </a>

        <ul class="dropdown-menu modern-dropdown-menu">
            <li class="user-header-modern">
                <div class="user-avatar-badge-lg">@initials</div>
                <div class="user-header-details">
                    <span class="user-name-lg">@displayName</span>
                    <span class="user-email-lg">@userName</span>
                </div>
            </li>
            <li class="divider"></li>
            <li><a href="#"><i class="fa fa-user-o"></i> Mi Perfil</a></li>
            <li><a href="#"><i class="fa fa-cog"></i> Configuración</a></li>
            <li class="divider"></li>
            <li>
                <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/Home/Index" method="post" id="logoutForm" style="margin: 0;">
                    <a href="javascript:document.getElementById('logoutForm').submit()" class="text-danger"><i class="fa fa-sign-out"></i> Cerrar Sesión</a>
                </form>
            </li>
        </ul>
    </li>
}
else
{
    <li>
        <ul class="nav navbar-nav navbar-right" style="margin-right:0px;">
            <li><a asp-area="Identity" asp-page="/Account/Login" class="btn-modern btn-modern-primary" style="margin-top: 12px;">Iniciar sesión</a></li>
        </ul>
    </li>
}
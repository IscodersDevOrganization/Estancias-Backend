@model DAL.DTOs.AdjuntosSolicitudDTO
@inject DAL.Data.EstanciasContext _context
@using Microsoft.EntityFrameworkCore
@using System.Collections.Generic

@{
    DateTime? fechaNac = null;
    string domicilio = null;
    string cp = null;

    if (ViewBag.FechaNacimiento != null)
    {
        fechaNac = (DateTime)ViewBag.FechaNacimiento;
    }
    if (ViewBag.Domicilio != null)
    {
        domicilio = (string)ViewBag.Domicilio;
    }
    if (ViewBag.CodigoPostal != null)
    {
        cp = (string)ViewBag.CodigoPostal;
    }

    if (string.IsNullOrEmpty(domicilio) && Model != null && Model.Id > 0)
    {
        var sol = _context.SolicitudDeTarjeta
            .Include(s => s.Localidad)
            .Include(s => s.Provincia)
            .FirstOrDefault(s => s.Id == Model.Id);
        if (sol != null)
        {
                        if (!fechaNac.HasValue)
            {
                fechaNac = sol.FechaNacimiento;
            }
            var loc = sol.Localidad != null ? sol.Localidad.Descripcion : "";
            var prov = sol.Provincia != null ? (!string.IsNullOrEmpty(sol.Provincia.DescripcionCompleta) ? sol.Provincia.DescripcionCompleta : sol.Provincia.Descripcion) : "";
            var direccion = $"{sol.Calle} {sol.Altura} {sol.PisoDepto}".Trim();
            var partes = new List<string>();
            if (!string.IsNullOrWhiteSpace(direccion))
            {
                partes.Add(direccion);
            }
            if (!string.IsNullOrWhiteSpace(loc))
            {
                partes.Add(loc);
            }
            if (!string.IsNullOrWhiteSpace(prov))
            {
                partes.Add(prov);
            }
            domicilio = string.Join(", ", partes);
            if (string.IsNullOrEmpty(cp))
            {
                cp = sol.CodigoPostal;
            }
        }
    }
}

<div class="row" style="margin-bottom: 15px;">
    <div class="col-md-12">
        <div style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 14px 18px; margin-bottom: 5px;">
            <div class="row">
                <div class="col-sm-5" style="margin-bottom: 8px;">
                    <span class="text-muted" style="font-size: 11px; display: block; text-transform: uppercase; font-weight: 600; letter-spacing: 0.5px;">Solicitante</span>
                    <strong style="font-size: 14px; color: #1e293b;"><i class="fa fa-user" style="color: #64748b; margin-right: 6px;"></i>@Model.NombreCompleto</strong>
                </div>
                <div class="col-sm-3" style="margin-bottom: 8px;">
                    <span class="text-muted" style="font-size: 11px; display: block; text-transform: uppercase; font-weight: 600; letter-spacing: 0.5px;">DNI</span>
                    <strong style="font-size: 14px; color: #1e293b;"><i class="fa fa-id-card-o" style="color: #64748b; margin-right: 6px;"></i>@Model.DNI</strong>
                </div>
                <div class="col-sm-4" style="margin-bottom: 8px;">
                    <span class="text-muted" style="font-size: 11px; display: block; text-transform: uppercase; font-weight: 600; letter-spacing: 0.5px;">Fecha Nacimiento</span>
                    <strong style="font-size: 14px; color: #1e293b;"><i class="fa fa-birthday-cake" style="color: #64748b; margin-right: 6px;"></i>@(fechaNac.HasValue ? fechaNac.Value.ToString("dd/MM/yyyy") : "-")</strong>
                </div>
            </div>
            <div class="row" style="margin-top: 6px; padding-top: 8px; border-top: 1px solid #edf2f7;">
                <div class="col-sm-9" style="margin-bottom: 4px;">
                    <span class="text-muted" style="font-size: 11px; display: block; text-transform: uppercase; font-weight: 600; letter-spacing: 0.5px;">Domicilio</span>
                    <strong style="font-size: 13px; color: #334155;"><i class="fa fa-map-marker" style="color: #64748b; margin-right: 6px;"></i>@(!string.IsNullOrWhiteSpace(domicilio) ? domicilio : "-")</strong>
                </div>
                <div class="col-sm-3" style="margin-bottom: 4px;">
                    <span class="text-muted" style="font-size: 11px; display: block; text-transform: uppercase; font-weight: 600; letter-spacing: 0.5px;">Código Postal</span>
                    <strong style="font-size: 13px; color: #334155;"><i class="fa fa-envelope-o" style="color: #64748b; margin-right: 6px;"></i>@(!string.IsNullOrWhiteSpace(cp) ? cp : "-")</strong>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="nav-tabs-custom">
            <ul class="nav nav-tabs" id="adjuntosModalTabs">
                <li class="active"><a href="javascript:void(0)" onclick="cambiarTabAdjunto(event, 'tab_frente')"><i class="fa fa-id-card-o"></i> Frente DNI</a></li>
                <li><a href="javascript:void(0)" onclick="cambiarTabAdjunto(event, 'tab_dorso')"><i class="fa fa-id-card"></i> Dorso DNI</a></li>
                <li><a href="javascript:void(0)" onclick="cambiarTabAdjunto(event, 'tab_selfie')"><i class="fa fa-user-circle-o"></i> Selfie</a></li>
            </ul>
            <div class="tab-content" style="min-height: 350px;">
                <div class="tab-pane active" id="tab_frente" style="display: block;">
                    <div class="text-center" style="padding: 15px;">
                        @if (!string.IsNullOrEmpty(Model.FrenteDNIBase64))
                        {
                            <img src="data:image/jpeg;base64,@Model.FrenteDNIBase64" alt="Frente DNI" class="img-responsive img-thumbnail center-block" style="max-height: 450px; margin: 0 auto;" />
                        }
                        else
                        {
                            <div class="alert alert-info text-center" style="margin: 20px;">
                                <i class="fa fa-info-circle"></i> No se adjuntó la imagen de Frente DNI.
                            </div>
                        }
                    </div>
                </div>
                <div class="tab-pane" id="tab_dorso" style="display: none;">
                    <div class="text-center" style="padding: 15px;">
                        @if (!string.IsNullOrEmpty(Model.DorsoDNIBase64))
                        {
                            <img src="data:image/jpeg;base64,@Model.DorsoDNIBase64" alt="Dorso DNI" class="img-responsive img-thumbnail center-block" style="max-height: 450px; margin: 0 auto;" />
                        }
                        else
                        {
                            <div class="alert alert-info text-center" style="margin: 20px;">
                                <i class="fa fa-info-circle"></i> No se adjuntó la imagen de Dorso DNI.
                            </div>
                        }
                    </div>
                </div>
                <div class="tab-pane" id="tab_selfie" style="display: none;">
                    <div class="text-center" style="padding: 15px;">
                        @if (!string.IsNullOrEmpty(Model.SelfieBase64))
                        {
                            <img src="data:image/jpeg;base64,@Model.SelfieBase64" alt="Selfie" class="img-responsive img-thumbnail center-block" style="max-height: 450px; margin: 0 auto;" />
                        }
                        else
                        {
                            <div class="alert alert-info text-center" style="margin: 20px;">
                                <i class="fa fa-info-circle"></i> No se adjuntó la imagen de Selfie.
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function cambiarTabAdjunto(e, tabId) {
        if (e) {
            e.preventDefault();
            e.stopPropagation();
        }
        $('#adjuntosModalTabs li').removeClass('active');
        $(e.currentTarget).parent().addClass('active');

        $('#tab_frente, #tab_dorso, #tab_selfie').removeClass('active').hide();
        $('#' + tabId).addClass('active').show();
    }
</script>
